# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# build & production
/dist
/build
*.tsbuildinfo

# logs & testing
/coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
tmp/
.vscode/

# environment variables (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Benchmark scratch — local tooling, not part of the build.
scratch/

# Every env variant, including backups and renames (.env.postgres.bak once
# carried the live JWT secret into a public repository). Only the example
# template is tracked.
.env.*
*.env
*.env.bak
!.env.example

# Deployment secrets that live only on the instance (see deploy/README.md).
# origin.key is a private key; .env.production holds JWT_SECRET, the Cashfree
# keys and the database password.
deploy/certs/
deploy/.env.production
# ...but the deploy template is documentation, not a secret: it carries only
# variable names and comments, and deploy/README.md tells you to copy it.
!deploy/.env.production.example
