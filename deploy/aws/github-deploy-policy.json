      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:ap-south-1:133644693890:instance/i-06cfd453071f5b301",
        "arn:aws:ssm:ap-south-1::document/AWS-RunShellScript"
