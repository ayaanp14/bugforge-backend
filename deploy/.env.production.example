# Copy to deploy/.env.production ON THE INSTANCE and fill in. Never commit the
# filled copy — .gitignore already excludes it.
#
# Most values carry straight over from the Railway environment. The three that
# change are DATABASE_URL, REDIS_URL and the two MySQL passwords, because both
# services now live on this box.

# ── database (local to this instance) ───────────────────────────────────
# Must match MYSQL_PASSWORD below. `mysql` is the compose service name.
# connection_limit can be generous now: the old shared host capped the whole
# account at 25 connections, this one is ours and max_connections is 60.
DATABASE_URL="mysql://codekairo:CHANGE_ME_APP@mysql:3306/codexa?connection_limit=10"
MYSQL_PASSWORD="CHANGE_ME_APP"
MYSQL_ROOT_PASSWORD="CHANGE_ME_ROOT"

# ── identity ────────────────────────────────────────────────────────────
# Carry the EXISTING value over from Railway. Changing it signs out every
# account on the platform at once (lib/auth-session.ts).
JWT_SECRET="CHANGE_ME"

# ── addresses ───────────────────────────────────────────────────────────
FRONTEND_URL="https://codekairo.com"
BACKEND_PUBLIC_URL="https://api.codekairo.com"

# ── code execution ──────────────────────────────────────────────────────
# Paiza is hosted and needs no key; judge0 is the fallback and there is no
# Judge0 on this box, so leave JUDGE0_URL unset rather than pointing it at
# something that will not answer.
EXECUTOR="paiza,judge0"
STUDY_EXECUTOR="paiza"

# ── outbound mail (Brevo) ───────────────────────────────────────────────
BREVO_API_KEY=""
MAIL_FROM_EMAIL="no-reply@codekairo.com"
MAIL_FROM_NAME="CodeKairo"
MAIL_REPLY_TO=""

# ── OAuth ───────────────────────────────────────────────────────────────
# The callback URLs registered with GitHub and Google must already point at
# https://api.codekairo.com — they do today, and this move does not change
# the hostname, so nothing needs re-registering.
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── models ──────────────────────────────────────────────────────────────
NVIDIA_API_KEY=""
NVIDIA_BASE_URL=""
INTERVIEW_MODEL=""
INTERVIEW_QUESTION_MODEL=""
GEMINI_API_KEY=""

# ── billing ─────────────────────────────────────────────────────────────
CASHFREE_ENV="production"
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""

# ── platform guard ──────────────────────────────────────────────────────
# Must match what the frontend bundle was built with, or every signed request
# is refused (middleware/platformGuard.ts).
PLATFORM_SECRET=""

# ── admin ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=""
OWNER_EMAILS=""

# ── email verification ──────────────────────────────────────────────────
# Leave on in production.
EMAIL_VERIFICATION="on"
