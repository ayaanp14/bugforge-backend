generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(500)
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique @db.VarChar(500)
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                 String            @id @default(cuid())
  name               String?
  email              String?           @unique
  emailVerified      DateTime?
  password_hash      String?
  provider           String            @default("email")
  xp                 Int               @default(0)
  questionsXp        Int               @default(0)
  bugsXp             Int               @default(0)
  rating             Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  avatar_url         String?           @db.Text
  instituteName      String?
  username           String?           @unique
  gender             String?
  location           String?
  birthday           DateTime?
  website            String?           @db.Text
  github             String?           @db.Text
  linkedin           String?           @db.Text
  twitter            String?           @db.Text
  readme             String?           @db.Text
  accounts           Account[]
  bugSubmissions     BugSubmission[]
  codeDrafts         CodeDraft[]
  roomsCreated       PairRoom[]
  roomParticipations RoomParticipant[]
  sessions           Session[]
  submissions        Submission[]
  stats              UserStats?
  problemTimers      ProblemTimer[]
  savedInterviews    SavedInterview[]
  mockSessions       MockInterviewSession[]
  notifications      Notification[]
  posts              Post[]
  postComments       PostComment[]
  postLikes          PostLike[]
  postCommentLikes   PostCommentLike[]
  savedPosts         SavedPost[]
  pollVotes          PollVote[]
  postReports        PostReport[]
  duels              DuelParticipant[]
  following          Follow[]          @relation("following")
  followers          Follow[]          @relation("followers")
  tagAffinities      TagAffinity[]

  // Rank is a COUNT of users above you and the leaderboard is an ORDER BY on the
  // same columns; without these both are full table scans on every dashboard load.
  @@index([xp])
  @@index([questionsXp])
  @@index([bugsXp])
}

model Problem {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String       @db.MediumText
  difficulty    String
  tags          Json         @default("[]")
  timeLimitMs   Int          @default(2000)
  memoryLimitMb Int          @default(256)
  editorial     String?      @db.MediumText
  isPublished   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  starterCode   Json?
  signature     Json?
  referenceSolution String?  @db.MediumText
  referenceLanguage String?
  hints         Json         @default("[]")
  codeDrafts    CodeDraft[]
  pairRooms     PairRoom[]
  submissions   Submission[]
  testCases     TestCase[]
  problemTimers ProblemTimer[]

  duels         Duel[]

  @@index([isPublished, createdAt])
}

model CodeDraft {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  code      String   @db.MediumText
  language  String
  updatedAt DateTime @default(now()) @updatedAt
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, language])
  // "Continue solving" reads the newest draft for one user.
  @@index([userId, updatedAt])
}

model ProblemTimer {
  id              String    @id @default(cuid())
  userId          String
  problemId       String
  elapsedSeconds  Int       @default(0)
  lastStartedAt   DateTime?
  isRunning       Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model TestCase {
  id             String  @id @default(cuid())
  problemId      String
  input          String  @db.MediumText
  expectedOutput String  @db.MediumText
  isHidden       Boolean @default(false)
  orderIndex     Int
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, orderIndex])
}


model Submission {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  roomId      String?
  code        String   @db.MediumText
  language    String
  verdict     String
  runtimeMs   Int?
  memoryKb    Int?
  passedCases Int      @default(0)
  totalCases  Int      @default(0)
  submittedAt DateTime @default(now())
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room        PairRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // The FK on userId alone leaves every "newest first" read to filesort the user's
  // whole history, and every verdict filter to scan it. These two cover the
  // dashboard's reads: history (userId+submittedAt) and heatmap/streak/solved
  // counts (userId+verdict, with submittedAt for the date range).
  @@index([userId, submittedAt])
  @@index([userId, verdict, submittedAt])
}

model BugChallenge {
  id          String          @id @default(cuid())
  title       String
  difficulty  String
  category    String
  language    String          @default("javascript")
  tags        Json            @default("[]")
  origin      String?
  description String          @db.MediumText
  bugReport   String          @db.MediumText
  logs        String?         @db.MediumText
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now())
  submissions BugSubmission[]
  files       ChallengeFile[]
  tests       ChallengeTest[]
  duels       Duel[]
}

model ChallengeFile {
  id          String       @id @default(cuid())
  challengeId String
  filePath    String
  content     String       @db.MediumText
  isEditable  Boolean      @default(true)
  language    String
  challenge   BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model ChallengeTest {
  id             String       @id @default(cuid())
  challengeId    String
  name           String
  runCommand     String       @db.Text
  expectedOutput String       @db.Text
  isHidden       Boolean      @default(false)
  challenge      BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model BugSubmission {
  id            String       @id @default(cuid())
  userId        String
  challengeId   String
  editedFiles   Json
  verdict       String
  passedTests   Int          @default(0)
  totalTests    Int          @default(0)
  timeTakenSecs Int?
  submittedAt   DateTime     @default(now())
  challenge     BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt])
}

model PairRoom {
  id           String            @id @default(cuid())
  createdBy    String
  problemId    String
  mode         String
  status       String            @default("waiting")
  inviteCode   String?
  recoveryCode String?           @unique
  maxParticipants Int            @default(2)
  startedAt    DateTime?
  endedAt      DateTime?
  kickedUserIds Json             @default("[]")
  creator      User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  problem      Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  participants RoomParticipant[]
  submissions  Submission[]
}

model RoomParticipant {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String
  joinedAt DateTime @default(now())
  room     PairRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model UserStats {
  id             String   @id @default(cuid())
  userId         String   @unique
  problemsSolved Int      @default(0)
  bugsFixed      Int      @default(0)
  pairSessions   Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActive     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedInterview {
  id              String   @id @default(cuid())
  userId          String
  roleId          String
  roundId         String
  difficulty      String
  experienceBand  String
  interviewStyle  String
  stackFocusIds   Json     @default("[]")
  focusAreaIds    Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockSessions    MockInterviewSession[]
}

model MockInterviewSession {
  id              String   @id @default(cuid())
  userId           String
  savedInterviewId String
  status           String         @default("started") // started, completed, abandoned
  gtwyThreadId     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedInterview   SavedInterview @relation(fields: [savedInterviewId], references: [id], onDelete: Cascade)
  questions        MockInterviewQuestion[]
}

model MockInterviewQuestion {
  id              String   @id @default(cuid())
  sessionId       String
  questionText    String   @db.Text
  topic           String?
  difficulty      String?
  focusArea       String?
  userAnswer      String?  @db.MediumText
  evaluationScore Int?
  feedback        String?  @db.Text
  starterCode     String?  @db.Text
  expectedSkills  Json     @default("[]")
  status          String   @default("pending") // pending, answered, evaluated
  orderIndex      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  session         MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String   @db.Text
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ── Kumite: 1v1 and 2v2 duels over a random problem or bug hunt ──────────
//
// A duel row *is* the queue: one sitting at status "waiting" with a free seat is
// what matchmaking joins, so there is no separate queue table to keep in sync.

model Duel {
  id          String    @id @default(cuid())
  mode        String    @default("1v1")     // "1v1" | "2v2"
  kind        String    @default("problem") // "problem" | "bug"
  status      String    @default("waiting") // waiting | active | finished | cancelled
  visibility  String    @default("public")  // public (matchmade) | private (invite code)
  roomCode    String?   @unique
  /** Average rating of the warriors already seated — the matchmaking band. */
  ratingBand  Int       @default(1200)
  problemId   String?
  challengeId String?
  createdBy   String
  startedAt   DateTime?
  endedAt     DateTime?
  winnerTeam  Int?
  createdAt   DateTime  @default(now())

  problem      Problem?          @relation(fields: [problemId], references: [id], onDelete: SetNull)
  challenge    BugChallenge?     @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  participants DuelParticipant[]

  @@index([status, mode, kind, visibility])
  @@index([createdBy])
  @@index([createdAt])
}

model DuelParticipant {
  id         String    @id @default(cuid())
  duelId     String
  userId     String
  team       Int       @default(1)
  ready      Boolean   @default(false)
  /** Live scoreboard: tests passed on this warrior's latest submission. */
  passed     Int       @default(0)
  total      Int       @default(0)
  verdict    String?
  finishedAt DateTime?
  xpAwarded  Int       @default(0)
  joinedAt   DateTime  @default(now())

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([duelId, userId])
  @@index([userId])
}

// ── Community: stories/status posts, achievement shares, comments, follows ──

model Post {
  id         String        @id @default(cuid())
  userId     String
  // "status" (story/life post) | "achievement" (shared solve) | "question" (help
  // request pinned to a problem/bug) | "poll"
  type       String        @default("status")
  visibility String        @default("public") // "public" | "followers" | "private"
  content    String        @db.Text
  meta      Json          @default("{}") // achievement payload: { kind: "problem"|"bug", slug?, challengeId?, title, difficulty?, xp? }; poll: { poll: { options: string[] } }; question: { ask: { slug?, challengeId?, title? } }
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  // Set the first time the author edits, so the card can say "edited"
  editedAt  DateTime?
  // Questions: the comment the asker accepted as the answer
  resolvedCommentId String?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  PostComment[]
  likes     PostLike[]
  tags      PostTag[]
  saves     SavedPost[]
  pollVotes PollVote[]
  reports   PostReport[]

  @@index([createdAt])
  @@index([userId, createdAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String   @db.Text
  // Threading is one level deep. Deliberately a plain column rather than a
  // self-relation: MySQL handles a self-referencing FK badly when the parent
  // post cascades, and the reply tree is assembled in the route anyway.
  parentId  String?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     PostCommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model PostCommentLike {
  id        String      @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime    @default(now())
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

// Bookmarks — "read it later", private to the saver.
model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

// One vote per person per poll; the options live in Post.meta.poll.options.
model PollVote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  option    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

// Moderation queue: one report per person per post.
model PostReport {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  reason    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tag    String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, tag])
  @@index([tag])
}

// Per-user interest profile: which tags this user engages with (implicit signals)
model TagAffinity {
  id        String   @id @default(cuid())
  userId    String
  tag       String
  score     Float    @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
}
