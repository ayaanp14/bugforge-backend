generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(500)
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique @db.VarChar(500)
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                 String            @id @default(cuid())
  name               String?
  email              String?           @unique
  emailVerified      DateTime?
  password_hash      String?
  provider           String            @default("email")
  xp                 Int               @default(0)
  questionsXp        Int               @default(0)
  bugsXp             Int               @default(0)
  rating             Int               @default(1200)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  avatar_url         String?           @db.Text
  instituteName      String?
  username           String?           @unique
  gender             String?
  location           String?
  birthday           DateTime?
  website            String?           @db.Text
  github             String?           @db.Text
  linkedin           String?           @db.Text
  twitter            String?           @db.Text
  readme             String?           @db.Text
  accounts           Account[]
  bugSubmissions     BugSubmission[]
  codeDrafts         CodeDraft[]
  roomsCreated       PairRoom[]
  roomParticipations RoomParticipant[]
  sessions           Session[]
  submissions        Submission[]
  stats              UserStats?
  problemTimers      ProblemTimer[]
  savedInterviews    SavedInterview[]
  mockSessions       MockInterviewSession[]
  notifications      Notification[]
}

model Problem {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String       @db.MediumText
  difficulty    String
  tags          Json         @default("[]")
  timeLimitMs   Int          @default(2000)
  memoryLimitMb Int          @default(256)
  editorial     String?      @db.MediumText
  isPublished   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  starterCode   Json?
  signature     Json?
  referenceSolution String?  @db.MediumText
  referenceLanguage String?
  hints         Json         @default("[]")
  codeDrafts    CodeDraft[]
  pairRooms     PairRoom[]
  submissions   Submission[]
  testCases     TestCase[]
  problemTimers ProblemTimer[]
}

model CodeDraft {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  code      String   @db.MediumText
  language  String
  updatedAt DateTime @default(now()) @updatedAt
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, language])
}

model ProblemTimer {
  id              String    @id @default(cuid())
  userId          String
  problemId       String
  elapsedSeconds  Int       @default(0)
  lastStartedAt   DateTime?
  isRunning       Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model TestCase {
  id             String  @id @default(cuid())
  problemId      String
  input          String  @db.MediumText
  expectedOutput String  @db.MediumText
  isHidden       Boolean @default(false)
  orderIndex     Int
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, orderIndex])
}


model Submission {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  roomId      String?
  code        String   @db.MediumText
  language    String
  verdict     String
  runtimeMs   Int?
  memoryKb    Int?
  passedCases Int      @default(0)
  totalCases  Int      @default(0)
  submittedAt DateTime @default(now())
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room        PairRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
}

model BugChallenge {
  id          String          @id @default(cuid())
  title       String
  difficulty  String
  category    String
  description String          @db.MediumText
  bugReport   String          @db.MediumText
  logs        String?         @db.MediumText
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now())
  submissions BugSubmission[]
  files       ChallengeFile[]
  tests       ChallengeTest[]
}

model ChallengeFile {
  id          String       @id @default(cuid())
  challengeId String
  filePath    String
  content     String       @db.MediumText
  isEditable  Boolean      @default(true)
  language    String
  challenge   BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model ChallengeTest {
  id             String       @id @default(cuid())
  challengeId    String
  name           String
  runCommand     String       @db.Text
  expectedOutput String       @db.Text
  isHidden       Boolean      @default(false)
  challenge      BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model BugSubmission {
  id            String       @id @default(cuid())
  userId        String
  challengeId   String
  editedFiles   Json
  verdict       String
  passedTests   Int          @default(0)
  totalTests    Int          @default(0)
  timeTakenSecs Int?
  submittedAt   DateTime     @default(now())
  challenge     BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PairRoom {
  id           String            @id @default(cuid())
  createdBy    String
  problemId    String
  mode         String
  status       String            @default("waiting")
  inviteCode   String?
  recoveryCode String?           @unique
  maxParticipants Int            @default(2)
  startedAt    DateTime?
  endedAt      DateTime?
  kickedUserIds Json             @default("[]")
  creator      User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  problem      Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  participants RoomParticipant[]
  submissions  Submission[]
}

model RoomParticipant {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String
  joinedAt DateTime @default(now())
  room     PairRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model UserStats {
  id             String   @id @default(cuid())
  userId         String   @unique
  problemsSolved Int      @default(0)
  bugsFixed      Int      @default(0)
  pairSessions   Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActive     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedInterview {
  id              String   @id @default(cuid())
  userId          String
  roleId          String
  roundId         String
  difficulty      String
  experienceBand  String
  interviewStyle  String
  stackFocusIds   Json     @default("[]")
  focusAreaIds    Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockSessions    MockInterviewSession[]
}

model MockInterviewSession {
  id              String   @id @default(cuid())
  userId           String
  savedInterviewId String
  status           String         @default("started") // started, completed, abandoned
  gtwyThreadId     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedInterview   SavedInterview @relation(fields: [savedInterviewId], references: [id], onDelete: Cascade)
  questions        MockInterviewQuestion[]
}

model MockInterviewQuestion {
  id              String   @id @default(cuid())
  sessionId       String
  questionText    String   @db.Text
  topic           String?
  difficulty      String?
  focusArea       String?
  userAnswer      String?  @db.MediumText
  evaluationScore Int?
  feedback        String?  @db.Text
  starterCode     String?  @db.Text
  expectedSkills  Json     @default("[]")
  status          String   @default("pending") // pending, answered, evaluated
  orderIndex      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  session         MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String   @db.Text
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
