generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                 String            @id @default(cuid())
  name               String?
  email              String?           @unique
  emailVerified      DateTime?
  password_hash      String?
  provider           String            @default("email")
  xp                 Int               @default(0)
  questionsXp        Int               @default(0)
  bugsXp             Int               @default(0)
  rating             Int               @default(1200)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  avatar_url         String?
  instituteName      String?
  username           String?           @unique
  gender             String?
  location           String?
  birthday           DateTime?
  website            String?
  github             String?
  linkedin           String?
  twitter            String?
  readme             String?
  accounts           Account[]
  bugSubmissions     BugSubmission[]
  codeDrafts         CodeDraft[]
  roomsCreated       PairRoom[]
  roomParticipations RoomParticipant[]
  sessions           Session[]
  submissions        Submission[]
  stats              UserStats?
  problemTimers      ProblemTimer[]
}

model Problem {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String
  difficulty    String
  tags          String[]
  timeLimitMs   Int          @default(2000)
  memoryLimitMb Int          @default(256)
  editorial     String?
  isPublished   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  starterCode   Json?
  referenceSolution String?
  referenceLanguage String?
  hints         String[] @default([])
  codeDrafts    CodeDraft[]
  pairRooms     PairRoom[]
  submissions   Submission[]
  testCases     TestCase[]
  problemTimers ProblemTimer[]
}

model CodeDraft {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  code      String
  language  String
  updatedAt DateTime @default(now()) @updatedAt
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, language])
}

model ProblemTimer {
  id              String    @id @default(cuid())
  userId          String
  problemId       String
  elapsedSeconds  Int       @default(0)
  lastStartedAt   DateTime?
  isRunning       Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model TestCase {
  id             String  @id @default(cuid())
  problemId      String
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)
  orderIndex     Int
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}


model Submission {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  roomId      String?
  code        String
  language    String
  verdict     String
  runtimeMs   Int?
  memoryKb    Int?
  passedCases Int      @default(0)
  totalCases  Int      @default(0)
  submittedAt DateTime @default(now())
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room        PairRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
}

model BugChallenge {
  id          String          @id @default(cuid())
  title       String
  difficulty  String
  category    String
  description String
  bugReport   String
  logs        String?
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now())
  submissions BugSubmission[]
  files       ChallengeFile[]
  tests       ChallengeTest[]
}

model ChallengeFile {
  id          String       @id @default(cuid())
  challengeId String
  filePath    String
  content     String
  isEditable  Boolean      @default(true)
  language    String
  challenge   BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model ChallengeTest {
  id             String       @id @default(cuid())
  challengeId    String
  name           String
  runCommand     String
  expectedOutput String
  isHidden       Boolean      @default(false)
  challenge      BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model BugSubmission {
  id            String       @id @default(cuid())
  userId        String
  challengeId   String
  editedFiles   Json
  verdict       String
  passedTests   Int          @default(0)
  totalTests    Int          @default(0)
  timeTakenSecs Int?
  submittedAt   DateTime     @default(now())
  challenge     BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PairRoom {
  id           String            @id @default(cuid())
  createdBy    String
  problemId    String
  mode         String
  status       String            @default("waiting")
  inviteCode   String?
  recoveryCode String?           @unique
  maxParticipants Int            @default(2)
  startedAt    DateTime?
  endedAt      DateTime?
  kickedUserIds String[]          @default([])
  creator      User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  problem      Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  participants RoomParticipant[]
  submissions  Submission[]
}

model RoomParticipant {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String
  joinedAt DateTime @default(now())
  room     PairRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStats {
  id             String   @id @default(cuid())
  userId         String   @unique
  problemsSolved Int      @default(0)
  bugsFixed      Int      @default(0)
  pairSessions   Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActive     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
