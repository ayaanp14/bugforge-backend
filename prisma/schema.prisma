generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "mysql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// A GitHub account its owner proved is theirs (the connect flow: POST
/// /api/me/github/connect → GitHub → routes/oauth.ts → /profile → POST
/// /api/me/github/complete), shown as the GitHub card on /profile. Only the
/// identity is kept — never a token; the activity is read with the server's
/// own token and cached (services/github-connection.ts). `githubId` is
/// GitHub's numeric user id, which survives a rename; `login` is the name last
/// seen and is corrected whenever a read finds it changed. Separate from
/// `Account` on purpose: that row is a way to sign in, this one is a profile
/// section, and either can exist without the other.
model GitHubConnection {
  userId   String   @id
  githubId String   @unique @db.VarChar(32)
  login    String   @db.VarChar(64)
  linkedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(500)
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique @db.VarChar(500)
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                    String                    @id @default(cuid())
  name                  String?
  email                 String?                   @unique
  emailVerified         DateTime?
  password_hash         String?
  /// Sessions issued before this instant are refused.
  ///
  /// A JWT cannot be taken back once handed out, so resetting a password could
  /// not evict whoever was already holding a token — exactly the person a
  /// reset is usually meant to remove. Stamping the account here and comparing
  /// against each token's issue time gives that back, without keeping a record
  /// of every session. Null means nothing has been revoked.
  sessionsValidFrom     DateTime?
  provider              String                    @default("email")
  xp                    Int                       @default(0)
  questionsXp           Int                       @default(0)
  bugsXp                Int                       @default(0)
  rating                Int                       @default(0)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  avatar_url            String?                   @db.Text
  instituteName         String?
  username              String?                   @unique
  gender                String?
  location              String?
  birthday              DateTime?
  website               String?                   @db.Text
  github                String?                   @db.Text
  linkedin              String?                   @db.Text
  twitter               String?                   @db.Text
  readme                String?                   @db.Text
  /// Reminder channels the account has left on. Booleans rather than a Json
  /// blob because the reminder jobs filter on them in SQL: "everyone with a
  /// live streak who has not opted out" must be one indexed query, not a scan
  /// that parses every row's preferences.
  remindStreak          Boolean                   @default(true)
  remindDailyKata       Boolean                   @default(true)
  weeklyDigest          Boolean                   @default(true)
  /// The review_due reminder (services/review-reminders.ts): a skill due on
  /// its spaced-review ladder. A column like the three above, for the same
  /// reason — the job filters on it in SQL.
  remindReviews         Boolean                   @default(true)
  reviewDue             ReviewDue?
  /// The public profile (/u/<username>) switched off by its owner: the
  /// public reads answer 404 to everyone else, exactly as for a username
  /// nobody holds, so a hidden profile cannot be told from a missing one.
  /// The account stays on the leaderboard and its public posts keep its
  /// name — without a link (author payloads carry the flag).
  profileHidden         Boolean                   @default(false)
  /// The career section of /u/<username> (Phase 8, ADAPTIVE_COACH.md §15):
  /// the skill profile's domain scores and the placement-readiness estimate
  /// appear there only when their owner switches them on. Off by default —
  /// the owner's decision, 2026-10-09. Verified facts need no switch.
  careerShowSkills      Boolean                   @default(false)
  careerShowReadiness   Boolean                   @default(false)
  /// The judge language the code editors open in (a driver-codegen
  /// ALL_LANGUAGES id): the last one picked on a problem or in a duel, on any
  /// device (PUT /api/me/language). Also an interview round's editor language
  /// when the round has no stack chosen. Null until a first pick, and the
  /// editors open in JavaScript.
  preferredLanguage     String?                   @db.VarChar(16)
  /// What the account is preparing for, answered on /welcome (lib/onboarding.ts
  /// GOALS: placements | product | language | practice); null until answered.
  /// A column rather than a key in `goalDetails` for the reason the reminder
  /// flags are: the digest and the admin breakdown ask "every placement
  /// student" as one indexed query.
  goal                  String?                   @db.VarChar(16)
  /// How comfortable the account is with coding problems (LEVELS: new | some |
  /// comfortable) — moves where the plan and "Up next" start.
  level                 String?                   @db.VarChar(16)
  /// The goal's follow-up answer: `{ companies?: string[], language?: string }`
  /// (parseOnboarding normalises it). Json because it is only ever read whole.
  goalDetails           Json?
  /// When the onboarding question was answered *or skipped*; null means never
  /// asked, which is what decides whether /welcome or the dashboard prompt is
  /// shown (onboardingStateOf).
  onboardedAt           DateTime?
  /// The minutes a day the account says it has (lib/mission MINUTE_CHOICES),
  /// set from the home's mission; null = never chosen, read as DEFAULT_MINUTES.
  /// On the account rather than only on the day so tomorrow's mission starts
  /// at today's choice, and /api/me can size the mission before it loads.
  dailyMinutes          Int?
  /// The placement target readiness reads (services/readiness.ts): a company as
  /// the tags or the test patterns spell it, optionally one of its test patterns
  /// (a MockTest slug — the role, where a company has several), and the date of
  /// the drive or interview. Null = not set; /readiness then asks.
  targetCompany         String?               @db.VarChar(80)
  targetTest            String?               @db.VarChar(120)
  targetDate            DateTime?             @db.Date
  missionDays           MissionDay[]
  simulationRuns        SimulationRun[]
  submissionAnalyses    SubmissionAnalysis[]
  tutorTurns            TutorTurn[]
  accounts              Account[]
  githubConnection      GitHubConnection?
  bugSubmissions        BugSubmission[]
  jobApplications       JobApplication[]
  bugEngagements        BugEngagement[]
  bugTutorTurns         BugTutorTurn[]
  bugAnalyses           BugSubmissionAnalysis[]
  sqlSubmissions        SqlSubmission[]
  sqlSolves             SqlSolve[]
  codeDrafts            CodeDraft[]
  roomsCreated          PairRoom[]
  roomParticipations    RoomParticipant[]
  sessions              Session[]
  submissions           Submission[]
  problemSolves         ProblemSolve[]
  stats                 UserStats?
  problemTimers         ProblemTimer[]
  problemEngagements    ProblemEngagement[]
  savedInterviews       SavedInterview[]
  mockSessions          MockInterviewSession[]
  subscriptions         Subscription[]
  paymentOrders         PaymentOrder[]
  notifications         Notification[]
  roadmapRewards        RoadmapReward[]
  studyEnrollments      StudyEnrollment[]
  studyLessons          StudyLessonProgress[]
  studyExercises        StudyExerciseSubmission[]
  assistantMessages     AssistantMessage[]
  posts                 Post[]
  postComments          PostComment[]
  postLikes             PostLike[]
  postCommentLikes      PostCommentLike[]
  savedPosts            SavedPost[]
  pollVotes             PollVote[]
  postReports           PostReport[]
  duels                 DuelParticipant[]
  following             Follow[]                  @relation("following")
  followers             Follow[]                  @relation("followers")
  tagAffinities         TagAffinity[]
  feedback              Feedback[]
  honours               Honour[]
  cohortsOwned          Cohort[]              @relation("CohortOwner")
  cohortMemberships     CohortMember[]
  aptitudeAttempts      AptitudeAttempt[]
  mockAttempts          MockAttempt[]
  skillAttempts         SkillAttempt[]
  skillCredentials      SkillCredential[]         @relation("credentialOwner")
  /// The credential whose frame this account wears round its avatar, or null
  /// for none (the roadmap ring, when there is one). Always one of the
  /// account's own credentials — the route checks — and cleared when the
  /// credential is revoked. A column here rather than a flag on the
  /// credential so every author payload reads it with one joined select.
  wornCredentialId      String?
  wornCredential        SkillCredential?          @relation("wornCredential", fields: [wornCredentialId], references: [id], onDelete: SetNull)
  dailyContests         DailyContestEntry[]
  revokedSessions       RevokedSession[]
  pushSubscriptions     PushSubscription[]
  resumes               Resume[]
  shareCards            ShareCard[]
  battleOrgs            BattleOrgMember[]
  tournamentEntries     TournamentEntry[]
  tournamentSubmissions TournamentSubmission[]
  knockoutMatchesA      TournamentMatch[]         @relation("matchPlayerA")
  knockoutMatchesB      TournamentMatch[]         @relation("matchPlayerB")

  // Rank is a COUNT of users above you and the leaderboard is an ORDER BY on the
  // same columns; without these both are full table scans on every dashboard load.
  @@index([xp])
  @@index([questionsXp])
  @@index([bugsXp])
  @@index([goal])
}

model Problem {
  id                    String                 @id @default(cuid())
  title                 String
  slug                  String                 @unique
  description           String                 @db.MediumText
  difficulty            String
  tags                  Json                   @default("[]")
  timeLimitMs           Int                    @default(2000)
  memoryLimitMb         Int                    @default(256)
  editorial             String?                @db.MediumText
  isPublished           Boolean                @default(false)
  createdAt             DateTime               @default(now())
  starterCode           Json?
  signature             Json?
  referenceSolution     String?                @db.MediumText
  referenceLanguage     String?
  /// Editorial reference solutions keyed by language ("python", "cpp", …).
  /// Drives the Editorial tab's language picker; only validated languages are
  /// written here, so a missing key means "not authored yet", not "broken".
  solutions             Json?
  hints                 Json                   @default("[]")
  codeDrafts            CodeDraft[]
  pairRooms             PairRoom[]
  submissions           Submission[]
  problemSolves         ProblemSolve[]
  testCases             TestCase[]
  problemTimers         ProblemTimer[]
  engagements           ProblemEngagement[]
  tutorTurns            TutorTurn[]
  dailyContests         DailyContest[]
  mockCodeAnswers       MockCodeAnswer[]
  skillCodeAnswers      SkillCodeAnswer[]
  tournamentProblems    TournamentProblem[]
  tournamentSubmissions TournamentSubmission[]
  roadmapStages         RoadmapStageProblem[]
  numbering             ProblemNumber?

  duels Duel[]

  @@index([isPublished, createdAt])
  // Problem search's text half (services/problem-search.ts): MATCH … AGAINST
  // over the statement. The title, tags and companies are matched against
  // the catalogue already in memory; only `description` is not held there,
  // and `LIKE '%q%'` on it read every MediumText row on every search.
  @@fulltext([title, description])
}

/// A problem's public number ("1. Two Sum"): searchable, sortable, and never
/// changed or reused once given. Oldest problem first, then each new problem
/// in turn, by lib/problem-numbers.ts — at API boot and after a create.
///
/// Its own table rather than a `number` column on Problem, for the same reason
/// as ProblemSolve: the claim is the invariant. The primary key is what stops
/// two assignments running at once from handing out one number twice, and
/// `problemId @unique` stops a problem getting two. A unique index added to
/// the existing Problem table is a change `db push` reads as possible data
/// loss and the deploy will not make unattended (measured 2026-10-03); a new
/// table is purely additive.
model ProblemNumber {
  number    Int     @id
  problemId String  @unique
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model CodeDraft {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  code      String   @db.MediumText
  language  String
  updatedAt DateTime @default(now()) @updatedAt
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, language])
  // "Continue solving" reads the newest draft for one user.
  @@index([userId, updatedAt])
}

model ProblemTimer {
  id             String    @id @default(cuid())
  userId         String
  problemId      String
  elapsedSeconds Int       @default(0)
  lastStartedAt  DateTime?
  isRunning      Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem        Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

/// One account's first contact with one problem: when it was opened, when
/// its hints were first shown and when its editorial was — the evidence the
/// skill profile (lib/skill-score.ts) cannot get from `Submission`, which
/// knows how a problem was solved but not whether the answer was read first.
///
/// First times only, each written once (`POST /api/problems/:slug/engagement`
/// sets a column only while it is null): the question the scoring asks is
/// "was help open before the first accept", and that needs the first time,
/// never the latest. A solve is timed from `openedAt` to the first accept
/// when that falls within one sitting (SOLVE_WINDOW_SECS); rows exist only
/// from 2026-10-07, so older solves are simply untimed and unassisted.
///
/// The natural key is the primary key, like ProblemNumber: there is nothing
/// else to identify, and an upsert on it is one statement.
model ProblemEngagement {
  userId      String
  problemId   String
  openedAt    DateTime  @default(now())
  hintsAt     DateTime?
  editorialAt DateTime?
  /// The tutor's highest rung reached on this problem (lib/tutor.ts RUNGS, 0–6).
  /// The rung never goes down: what was shown cannot be unseen.
  tutorRung       Int?
  /// First time the tutor gave hint-level help (rungs 1–3) / solution-level
  /// help (rungs 4–6). Folded into hintsAt / editorialAt by the skill profile,
  /// so the tutor counts as the help it gave, by the same before-the-solve rule.
  tutorHintAt     DateTime?
  tutorSolutionAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([userId, problemId])
  @@index([problemId])
}

/// One line of the Socratic tutor's conversation on a problem
/// (services/tutor.ts): the student's message or the tutor's answer, with
/// the rung it was asked and answered at. Kept so the thread survives a
/// reload and the next answer reads what was said; "Clear" deletes the rows
/// (the rung and the help it counted stay on ProblemEngagement).
model TutorTurn {
  id            String   @id @default(cuid())
  userId        String
  problemId     String
  /// "student" | "tutor"
  role          String   @db.VarChar(8)
  rung          Int
  content       String   @db.Text
  model         String?  @db.VarChar(120)
  promptVersion Int?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// The thread on one problem, in order.
  @@index([userId, problemId, createdAt])
  @@index([problemId])
}

/// "Why it failed": the explanation of one submission that was not accepted
/// (services/submission-analysis.ts). Two layers. `deterministic` is what
/// the judge's own report says — the verdict's class, the cases passed, the
/// time against the limit, the error parsed, the complexity the constraints
/// call for (lib/failure-analysis.ts) — and is there within a moment of the
/// verdict. `ai` is the model's reading of the code against the statement
/// (lib/submission-review.ts), written by an in-process runner, never in a
/// duel, a Battles match or on the day's contest problem (`reason`).
///
/// Stored, not derived: the model's answer costs a call and is not
/// reproducible, so it is kept per submission and reused for the same code
/// resubmitted (`codeHash`). `context` holds what the judge reported that
/// the Submission row does not keep (the error output, the time limit).
model SubmissionAnalysis {
  submissionId   String     @id
  userId         String
  problemId      String
  /// "queued" | "running" | "done" | "failed" | "skipped"
  status         String     @db.VarChar(16)
  /// Why the model did not run: "contest" | "duel" | "unavailable" | "error"; "reused" when its answer was copied.
  reason         String?    @db.VarChar(32)
  /// The mistake class — the model's when it ran, the verdict's otherwise.
  category       String?    @db.VarChar(32)
  context        Json
  deterministic  Json
  ai             Json?
  /// The skill the failure points at and what to do next (lib/skill-profile recommendFor).
  recommendation Json?
  model          String?    @db.VarChar(120)
  promptVersion  Int?
  codeHash       String     @db.Char(64)
  tokens         Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The account's analyses over time (the skill profile's causes, the export).
  @@index([userId, createdAt])
  /// "Has this exact code been explained before" — reuse instead of a second call.
  @@index([userId, problemId, codeHash])
  /// The runner's recovery at boot: young rows still queued or running.
  @@index([status, createdAt])
}

/// When an account's next skill review falls due — an index, not a record:
/// a copy of what its skill profile (lib/skill-score reviewSchedule) last
/// said, written whenever the profile is computed (services/skill-profile.ts).
///
/// The review reminder needs "who has a skill due today" across every
/// account, and the profile that knows is seven reads and a scoring pass per
/// account — fine for one page, not for a nightly sweep of all of them. A
/// review date only moves when new attempts arrive (the ladder is walked over
/// attempt days), so this copy stays exact until the next attempt; the job
/// reads due rows by `dueAt` on its index and recomputes only the accounts
/// with an attempt newer than `computedAt` (services/review-reminders.ts).
/// An account whose profile has not been computed since it was last here has
/// no row and is not reminded — the job reaches people who have used this.
model ReviewDue {
  userId     String   @id
  /// The earliest next review among the account's started skills.
  dueAt      DateTime
  /// [{ key, label, dueAt }] for the earliest few, soonest first.
  skills     Json
  computedAt DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dueAt])
}

/// One account's mission for one day (lib/mission.ts): the items chosen and
/// the ticks made by hand. Stored, unlike the skill profile it is built from,
/// because the list must hold still through the day — re-picked on every
/// read, an item would vanish the moment it was solved (the profile stops
/// recommending a solved problem). Which items are done is still read from
/// the evidence (services/mission.ts); `marks` holds only what no row can
/// say: a roadmap lesson read, an item skipped.
///
/// `day` is the platform calendar's date (lib/clock dayKey, IST), so the
/// mission turns over with the streak. Old days are kept as the record of
/// what was set and done — the outcome analysis Phase 5 needs.
model MissionDay {
  userId    String
  day       String   @db.VarChar(10)
  minutes   Int
  /// MissionItem[], in display order.
  items     Json
  /// { [itemId]: "done" | "skipped" }.
  marks     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

/// A company simulation sat by one account (lib/simulations, Phase 7 of
/// ADAPTIVE_COACH.md): the company's online assessment and its interview
/// rounds, in order, as one run. What each round scored is read from the
/// rows the round produced — the graded sitting of the pattern started after
/// the round opened, the interview session of the round's own saved setup —
/// and never copied here (lib/simulation-run.ts).
model SimulationRun {
  id              String           @id @default(cuid())
  userId          String
  /// lib/simulations slug.
  slug            String           @db.VarChar(80)
  /// "written" | "voice": how its HR, managerial and behavioural rounds are
  /// held — the candidate's choice at the start. Technical and coding rounds
  /// are always written (they need the editor).
  hrMode          String           @db.VarChar(8)
  /// [{ key, openedAt, savedInterviewId? }]: the rounds opened so far, in order.
  rounds          Json
  /// Ended by the candidate before the last round finished; null otherwise.
  endedAt         DateTime?
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedInterviews SavedInterview[]

  @@index([userId, slug, createdAt])
  @@index([userId, createdAt])
}

model TestCase {
  id             String  @id @default(cuid())
  problemId      String
  input          String  @db.MediumText
  expectedOutput String  @db.MediumText
  isHidden       Boolean @default(false)
  orderIndex     Int
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  // isHidden before orderIndex: a Run, the tutor, a review and every sitting's
  // coding question read only the visible cases, and under (problemId,
  // orderIndex) that was a lookup of every one of the problem's ~5,000 rows to
  // keep three — EXPLAIN ANALYZE on the 10M-row table (2026-10-10, two-sum):
  // 5,003 rows examined and 37.8 ms warm, against 3 rows and 0.03 ms here.
  // The full suite reads (isHidden, orderIndex) order off the same index, which
  // is the same sequence because every visible case sorts below every hidden
  // one (checked across the catalogue). Replaced rather than added: a second
  // index on this table is ~540 MB, this one is ~75 MB more than the old.
  @@index([problemId, isHidden, orderIndex])
}

/// One row the first time an account has a problem accepted — the record that
/// its XP has been paid.
///
/// The payout used to be guarded by locking the solver's `User` row and asking
/// `Submission` again under the lock, because "has this been solved before" is
/// not something `Submission` can answer atomically: it holds every attempt, so
/// two accepted submissions arriving together both saw no prior accept. The
/// lock made that safe at the cost of a per-user mutex held across the network,
/// which every other write to that account queued behind.
///
/// Here the claim *is* the invariant: the unique pair means the first insert
/// wins and every later one is a duplicate-key error, so the database decides
/// who pays and nothing has to be locked. Same shape as RoadmapReward, which
/// settles the identical question for a roadmap chest.
///
/// It records the payout, not the solve: solved-status and counts are still
/// derived from `Submission` everywhere they were before, so this table adds a
/// fact rather than moving one.
model ProblemSolve {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  /// When the winning submission landed — for a backfilled row, the earliest accept.
  submittedAt DateTime @default(now())
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The constraint the payout relies on. It also indexes (userId) and
  /// (userId, problemId); MySQL indexes the problemId foreign key on its own,
  /// so nothing else is needed here.
  @@unique([userId, problemId])
}

model Submission {
  id                   String                @id @default(cuid())
  userId               String
  problemId            String
  roomId               String?
  code                 String                @db.MediumText
  language             String
  verdict              String
  runtimeMs            Int?
  memoryKb             Int?
  passedCases          Int                   @default(0)
  totalCases           Int                   @default(0)
  submittedAt          DateTime              @default(now())
  problem              Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  room                 PairRoom?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// Set when this attempt was made in a Battles contest (services/contest.ts).
  tournamentSubmission TournamentSubmission?
  /// "Why it failed", for a submission that was not accepted (services/submission-analysis.ts).
  analysis             SubmissionAnalysis?

  // The FK on userId alone leaves every "newest first" read to filesort the user's
  // whole history, and every verdict filter to scan it. These two cover the
  // dashboard's reads: history (userId+submittedAt) and heatmap/streak/solved
  // counts (userId+verdict, with submittedAt for the date range).
  @@index([userId, submittedAt])
  @@index([userId, verdict, submittedAt])
  // Per-problem lookups (prevSolved on submit, a problem's attempt history, duel
  // settlement) otherwise walk the whole userId prefix; the global verdict index
  // serves the community bulletin group-bys, which were a full table scan.
  @@index([userId, problemId, submittedAt])
  @@index([verdict, submittedAt])
  // Acceptance rate per problem (services/problem-acceptance.ts): a GROUP BY
  // problemId, verdict over the whole table every ten minutes. Without this
  // it walks the clustered index — every row's `code` included — through a
  // 512 MB buffer pool; with it, the read never leaves this index.
  @@index([problemId, verdict])
}

model BugChallenge {
  id          String          @id @default(cuid())
  /// The public address (/bug-hunts/<slug>), derived from the title by
  /// lib/slug.ts and written by seed-bugs.ts. Optional only so a database that
  /// predates the column keeps serving until scripts/backfill-bug-slugs.ts has
  /// run; a row without one stays reachable by id, and an id address 301s to
  /// the slug once it exists. The cuid sat in every public URL for a year — a
  /// crawler's address for a page should be its title, not a database key.
  slug        String?         @unique
  title       String
  difficulty  String
  category    String
  language    String          @default("javascript")
  tags        Json            @default("[]")
  origin      String?
  description String          @db.MediumText
  bugReport   String          @db.MediumText
  logs        String?         @db.MediumText
  /// What the shipped build does on the visible tests: [{name, passed, detail}]
  /// — the incident's "failing checks". Written once by the API the first time
  /// the hunt is read without it (services/bug-coach.ts fillSymptoms), from a
  /// real run of the buggy files; null until then. Never a hidden test.
  symptoms    Json?
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now())
  submissions BugSubmission[]
  files       ChallengeFile[]
  tests       ChallengeTest[]
  duels       Duel[]
  engagements BugEngagement[]
  tutorTurns  BugTutorTurn[]

  // The catalogue reads: published-by-category ordered by difficulty (bug hunts
  // index) and published-newest-first (duel picks, dashboard counts).
  @@index([isPublished, category, difficulty])
  @@index([isPublished, createdAt])
}

model ChallengeFile {
  id          String       @id @default(cuid())
  challengeId String
  filePath    String
  content     String       @db.MediumText
  isEditable  Boolean      @default(true)
  language    String
  challenge   BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model ChallengeTest {
  id             String       @id @default(cuid())
  challengeId    String
  name           String
  runCommand     String       @db.Text
  expectedOutput String       @db.Text
  isHidden       Boolean      @default(false)
  challenge      BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model BugSubmission {
  id            String       @id @default(cuid())
  userId        String
  challengeId   String
  editedFiles   Json
  verdict       String
  passedTests   Int          @default(0)
  totalTests    Int          @default(0)
  timeTakenSecs Int?
  submittedAt   DateTime     @default(now())
  /// The postmortem (Phase 6, ADAPTIVE_COACH.md §14): the hunter's own account
  /// of the root cause, written after an accepted fix and scored by the model
  /// against lib/root-cause.ts RUBRIC. Never pays XP — a hunt's PASS can be
  /// forged (CLAUDE.md, Scoring integrity), and so can a well-written story.
  rootCause              String?  @db.Text
  rootCauseAt            DateTime?
  /// "queued" | "running" | "done" | "failed" | "skipped"
  rootCauseStatus        String?  @db.VarChar(16)
  /// {criteria: [{key, score, max, note}], summary, missed, confidence}
  rootCauseReview        Json?
  /// 0–100, the rubric's points scaled; null until scored.
  rootCauseScore         Int?
  rootCauseModel         String?  @db.VarChar(120)
  rootCausePromptVersion Int?
  challenge     BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis      BugSubmissionAnalysis?

  @@index([userId, submittedAt])
  // alreadySolved / quota / duel checks filter by challenge; streak, stats and
  // the "me" payload filter by verdict; the bulletin groups the whole table.
  @@index([userId, challengeId, submittedAt])
  @@index([userId, verdict, submittedAt])
  @@index([verdict, submittedAt])
  // Boot recovery of postmortem scoring (services/bug-coach.ts) reads queued/
  // running rows by rootCauseStatus ordered by rootCauseAt — a full scan of
  // the table (editedFiles Json included) on every API start without this.
  @@index([rootCauseStatus, rootCauseAt])
}

/// A member's contact with a hunt, timed by the server (Phase 6): when they
/// first opened it, when they paged themselves into incident mode, and the
/// debugging tutor's ladder. Diagnosis time is *derived* from this and the
/// first accepted BugSubmission (lib/bug-incident.ts diagnosisOf) — the
/// client's timeTakenSecs stays on the row but is no longer what counts.
/// One job or internship the member is applying for (Phase 8): a private
/// tracker, never on the public profile. The company is free text; it links
/// to readiness and a simulation when lib/applications.ts can match it.
model JobApplication {
  id        String    @id @default(cuid())
  userId    String
  company   String    @db.VarChar(120)
  role      String    @db.VarChar(120)
  /// lib/applications.ts STAGES: saved | applied | assessment | interviewing | offer | rejected | withdrawn
  stage     String    @db.VarChar(16)
  /// on-campus | off-campus | referral | other
  source    String?   @db.VarChar(16)
  link      String?   @db.VarChar(500)
  appliedOn DateTime? @db.Date
  /// The next dated step (a test, an interview, a deadline) and what it is.
  nextOn    DateTime? @db.Date
  nextLabel String?   @db.VarChar(80)
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model BugEngagement {
  userId          String
  challengeId     String
  openedAt        DateTime     @default(now())
  /// "Start incident": the clock the diagnosis runs from. Null = practice.
  incidentAt      DateTime?
  /// The debugging tutor's highest rung (lib/bug-tutor.ts BUG_RUNGS, 0–6).
  tutorRung       Int?
  tutorHintAt     DateTime?
  tutorSolutionAt DateTime?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge       BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([userId, challengeId])
  @@index([challengeId])
}

/// The debugging tutor's thread on one hunt (services/bug-coach.ts).
model BugTutorTurn {
  id            String       @id @default(cuid())
  userId        String
  challengeId   String
  /// "student" | "tutor"
  role          String       @db.VarChar(8)
  rung          Int
  content       String       @db.Text
  model         String?      @db.VarChar(120)
  promptVersion Int?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge     BugChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, challengeId, createdAt])
  @@index([challengeId])
}

/// "Why it failed" for a hunt: SubmissionAnalysis's twin, keyed by the
/// BugSubmission (lib/bug-failure.ts + the bug-review prompt).
model BugSubmissionAnalysis {
  submissionId  String        @id
  userId        String
  challengeId   String
  /// "queued" | "running" | "done" | "failed" | "skipped"
  status        String        @db.VarChar(16)
  /// "duel" | "unavailable" | "error" | "busy" | "reused"
  reason        String?       @db.VarChar(32)
  category      String?       @db.VarChar(32)
  deterministic Json
  ai            Json?
  model         String?       @db.VarChar(120)
  promptVersion Int?
  codeHash      String        @db.Char(64)
  tokens        Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  submission    BugSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, challengeId, codeHash])
  @@index([status, createdAt])
}

// SQL problems (src/lib/sql-problems — specs in code, not rows; the slug is
// the problem's identity). Every /submit is one SqlSubmission; a first
// accepted one also claims a SqlSolve, whose unique (userId, slug) makes the
// XP payout one-shot the way ProblemSolve does for coding problems
// (lib/solve-payout.ts explains why the claim, not a prior read, decides).
model SqlSubmission {
  id          String   @id @default(cuid())
  userId      String
  slug        String   @db.VarChar(120)
  query       String   @db.Text
  verdict     String   @db.VarChar(24)
  passedCases Int      @default(0)
  totalCases  Int      @default(0)
  runtimeMs   Float    @default(0)
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, slug, submittedAt])
  @@index([userId, verdict, submittedAt])
  @@index([slug, verdict])
}

model SqlSolve {
  id          String   @id @default(cuid())
  userId      String
  slug        String   @db.VarChar(120)
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([slug])
}

model PairRoom {
  id              String            @id @default(cuid())
  createdBy       String
  problemId       String
  mode            String
  status          String            @default("waiting")
  inviteCode      String?
  recoveryCode    String?           @unique
  maxParticipants Int               @default(2)
  startedAt       DateTime?
  endedAt         DateTime?
  kickedUserIds   Json              @default("[]")
  creator         User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  problem         Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  participants    RoomParticipant[]
  submissions     Submission[]
  cohortSession   CohortSession?

  // The public waiting list and the dashboard's closed-room history both
  // filter on status and sort on a timestamp; without these they scan.
  @@index([status, startedAt])
  @@index([status, endedAt])
}

model RoomParticipant {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String
  joinedAt DateTime @default(now())
  room     PairRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model UserStats {
  id             String   @id @default(cuid())
  userId         String   @unique
  problemsSolved Int      @default(0)
  bugsFixed      Int      @default(0)
  pairSessions   Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActive     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedInterview {
  id             String                 @id @default(cuid())
  userId         String
  roleId         String
  roundId        String
  difficulty     String
  experienceBand String
  interviewStyle String
  stackFocusIds  Json                   @default("[]")
  focusAreaIds   Json                   @default("[]")
  /// The company the round is practised for (a company simulation's round,
  /// lib/simulations): the interviewer's brief names it. Null for a setup
  /// built by hand.
  company        String?                @db.VarChar(80)
  /// The simulation run this setup was made for. Such a setup is the run's,
  /// not the member's: it is left out of the saved-setups list, its cap and
  /// the dashboard's count.
  simulationRunId String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulationRun  SimulationRun?         @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)
  mockSessions   MockInterviewSession[]

  /// The builder lists a user's templates newest-first and nothing else.
  @@index([userId, createdAt])
  @@index([simulationRunId])
}

model MockInterviewSession {
  id               String  @id @default(cuid())
  userId           String
  savedInterviewId String
  status           String  @default("started") // started, completed, abandoned
  /// Dead: left in place so a schema push stays additive. Safe to drop later.
  gtwyThreadId     String?

  /// How many questions this interview runs, fixed when it starts.
  questionBudget Int       @default(7)
  /// The editor language this round runs in, fixed at /start: the configured
  /// stack's, else the account's preferredLanguage, else JavaScript. Fixed
  /// rather than read live, so a language picked on a problem mid-round
  /// cannot turn the next question's stub into another language. Null on
  /// rounds started before 2026-10-05, which read the stack's (or JavaScript).
  language       String?   @db.VarChar(16)
  completedAt    DateTime?

  // ── interaction layer ──────────────────────────────────────────────────
  //
  // "written" is the typed round Nemotron has always run; "voice" is the
  // realtime spoken round. Everything below this line is null on a written
  // session, and the default keeps every row written before voice existed
  // reading as what it actually was.
  mode             String    @default("written") // "written" | "voice"
  /// Admitted on a roadmap chest's bonus session rather than the plan's
  /// weekly allowance. Set at /start when the allowance was already used;
  /// the credit is spent only if the round is actually sat (the same rule
  /// the weekly count applies), so a round abandoned at the door costs
  /// nothing — services/entitlements.ts counts these rows to find the balance.
  onCredit         Boolean   @default(false)
  /// Realtime vendor, kept as data so a second provider needs no migration.
  provider         String?
  /// The exact realtime model that ran, for cost attribution after the fact.
  realtimeModel    String?
  /// When audio actually started, as opposed to when the row was created.
  startedAt        DateTime?
  endedAt          DateTime?
  durationSec      Int?
  /// The wall-clock budget the candidate chose, in seconds. A spoken round is
  /// bounded by time rather than by a question count — how many questions fit
  /// is an outcome, not a setting — and the round closes itself when this runs
  /// out. Null on a written round, which is still question-bounded.
  durationLimitSec Int?
  /// The structured interview state the realtime round is conducted from —
  /// current question, topics covered, weak areas. Not the transcript.
  ///
  /// Nullable rather than defaulted: MySQL cannot put a literal default on a
  /// JSON column, so adding it NOT NULL to a table that already holds sessions
  /// is an ALTER that can fail outright. Readers go through `stateOf()`, which
  /// treats null as a fresh state anyway.
  voiceState       Json?

  // Closing report. Numbers are computed from the questions, not from the model.
  overallScore   Int?
  summary        String? @db.Text
  strengths      Json    @default("[]")
  weaknesses     Json    @default("[]")
  nextSteps      Json    @default("[]")
  topicBreakdown Json    @default("[]")

  // What the session cost to run, accumulated across every model call.
  promptTokens     Int @default(0)
  cachedTokens     Int @default(0)
  completionTokens Int @default(0)
  reasoningTokens  Int @default(0)
  costMicros       Int @default(0)

  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedInterview SavedInterview          @relation(fields: [savedInterviewId], references: [id], onDelete: Cascade)
  questions      MockInterviewQuestion[]
  events         InterviewEvent[]

  /// The history list: one user's sessions, newest first, cursor-paged.
  @@index([userId, createdAt])
  /// The same list filtered to a status chip, and the "is a round already open
  /// for this user" lookup that keeps /start from opening a second one.
  @@index([userId, status, createdAt])
  /// Ranking by score reads overallScore in order within one user.
  @@index([userId, overallScore])
  @@index([savedInterviewId])
}

model MockInterviewQuestion {
  id              String               @id @default(cuid())
  sessionId       String
  questionText    String               @db.Text
  topic           String?
  difficulty      String?
  focusArea       String?
  userAnswer      String?              @db.MediumText
  evaluationScore Int?
  feedback        String?              @db.Text
  /// "strong" | "adequate" | "weak" | "no_answer"
  verdict         String?
  /// Points a strong answer would have covered and this one did not.
  missed          Json                 @default("[]")
  /// Spoken rounds only: the probes the interviewer asked on this same answer
  /// ("did you check the logs?"), quoted one sentence each. They are scored as
  /// part of this row rather than as questions of their own, and listed so the
  /// report accounts for everything the candidate heard asked. A written round
  /// never asks a follow-up, so its rows keep the default.
  followUps       Json                 @default("[]")
  starterCode     String?              @db.Text
  expectedSkills  Json                 @default("[]")
  status          String               @default("pending") // pending, answered, evaluated
  orderIndex      Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  session         MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// A slot belongs to exactly one question. Two answers submitted for the same
  /// question at once would otherwise each append a "next question" at the same
  /// index, and the interview would fork — the check in /answer runs before a
  /// model call that takes seconds, so both requests can pass it.
  /// Doubles as the index for every read of a session's questions, which is
  /// always ordered by slot — so no separate @@index is needed.
  @@unique([sessionId, orderIndex])
}

/// Everything that happened during a realtime round, in the order it happened.
///
/// A voice interview has no natural row-per-question rhythm to hang state off —
/// the model asks, the candidate talks over it, the model follows up, and only
/// afterwards is any of that separable into questions. So the conversation is
/// stored as it arrives and the question rows are derived from it at /complete.
/// That also means a browser that dies mid-round leaves everything said up to
/// that point already on disk.
model InterviewEvent {
  id             String               @id @default(cuid())
  sessionId      String
  /// Per-session monotonic counter, assigned by the client that owns the
  /// socket. Ordering by `createdAt` cannot work: a batch of events written in
  /// one round trip shares a timestamp to the millisecond.
  sequence       Int
  /// "candidate" | "interviewer" | "system"
  speaker        String
  /// "transcript" | "interview_started" | "interruption" | "question_started" |
  /// "connection_lost" | "error" | … — open set, read by analytics only.
  type           String
  text           String?              @db.Text
  /// Which question this belongs to, as counted by the running interview state.
  questionNumber Int?
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now())
  session        MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Idempotent replay: a retried batch re-sends sequence numbers already
  /// written, and the unique constraint is what makes that a no-op rather than
  /// a duplicated turn. Doubles as the ordered read index for /complete.
  @@unique([sessionId, sequence])
}

/// A paid plan the user currently holds.
///
/// Access is decided by `status = "active" AND currentPeriodEnd > now`, which
/// is a query rather than a flag on User — a flag would need a cron to flip it
/// the moment a period lapsed, and the day that cron failed everyone would keep
/// their entitlements for free.
model Subscription {
  id               String   @id @default(cuid())
  userId           String
  /// "starter" | "pro" | "elite" — resolved through lib/plans.ts.
  planId           String
  /// "monthly" | "yearly"
  period           String
  /// "active" | "expired" | "cancelled"
  status           String   @default("active")
  startedAt        DateTime @default(now())
  currentPeriodEnd DateTime
  /// The order that paid for this period.
  orderId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The entitlement lookup on every metered request: one user's live rows,
  /// newest expiry first.
  @@index([userId, status, currentPeriodEnd])
}

/// One attempt to pay for a plan.
///
/// Written before the user is sent to the gateway, so a webhook that arrives
/// for an order we never created is rejected rather than granting access. The
/// id doubles as the gateway's `order_id`.
model PaymentOrder {
  id                String   @id
  userId            String
  planId            String
  period            String
  /// Rupees. Integer because every price in the catalogue is whole rupees.
  amount            Int
  currency          String   @default("INR")
  /// "created" | "paid" | "failed" | "expired"
  status            String   @default("created")
  provider          String   @default("cashfree")
  /// Returned by the gateway; the browser needs it to open checkout.
  paymentSessionId  String?  @db.Text
  providerPaymentId String?
  /// The verified gateway payload, kept for reconciliation and disputes.
  raw               Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// An application to run CodeKairo on a campus.
///
/// Deliberately not related to `User`: people apply before they have an
/// account, and an application is a record of something that happened which
/// should outlive the account it may later be attached to. `userId` is
/// therefore a plain column, filled in when the applicant happened to be signed
/// in, and never a foreign key that would cascade the application away.
model CampusAmbassador {
  id             String   @id @default(cuid())
  name           String
  /// Unique: one application per person. A second attempt is answered with
  /// "we already have yours" rather than quietly creating a duplicate.
  email          String   @unique
  phone          String?
  college        String
  city           String?
  graduationYear String?
  linkedin       String?  @db.Text
  instagram      String?  @db.Text
  /// Free text: the clubs, groups or following they can actually reach.
  reach          String?  @db.Text
  why            String   @db.Text
  /// "pending" | "accepted" | "rejected"
  status         String   @default("pending")
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// The review queue: oldest pending first.
  @@index([status, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String   @db.Text
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  // One-shot dedupe (createNotificationOnce / notifyOnce) looks up by type.
  @@index([userId, type])
}

// ── Kumite: 1v1 and 2v2 duels over a random problem or bug hunt ──────────
//
// A duel row *is* the queue: one sitting at status "waiting" with a free seat is
// what matchmaking joins, so there is no separate queue table to keep in sync.

model Duel {
  id          String    @id @default(cuid())
  mode        String    @default("1v1") // "1v1" | "2v2"
  kind        String    @default("problem") // "problem" | "bug"
  status      String    @default("waiting") // waiting | active | finished | cancelled
  visibility  String    @default("public") // public (matchmade) | private (invite code)
  roomCode    String?   @unique
  /**
   * Average rating of the warriors already seated — the matchmaking band.
   */
  ratingBand  Int       @default(1200)
  problemId   String?
  challengeId String?
  createdBy   String
  startedAt   DateTime?
  endedAt     DateTime?
  winnerTeam  Int?
  createdAt   DateTime  @default(now())

  problem      Problem?          @relation(fields: [problemId], references: [id], onDelete: SetNull)
  challenge    BugChallenge?     @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  participants DuelParticipant[]

  // The queue scan also bounds and orders by createdAt; the trailing column
  // lets MySQL stop at the range instead of filesorting the matches.
  @@index([status, mode, kind, visibility, createdAt])
  @@index([createdBy])
  @@index([createdAt])
}

model DuelParticipant {
  id             String    @id @default(cuid())
  duelId         String
  userId         String
  team           Int       @default(1)
  ready          Boolean   @default(false)
  /**
   * Live scoreboard: tests passed on this warrior's latest submission.
   */
  passed         Int       @default(0)
  total          Int       @default(0)
  verdict        String?
  finishedAt     DateTime?
  xpAwarded      Int       @default(0)
  joinedAt       DateTime  @default(now())
  /**
   * When this player's last socket left the duel room; null while they are
   * in it. A duel has no clock: an opponent gone past the grace period can be
   * claimed (POST /api/duels/:id/claim), and a duel everyone left a day ago
   * is called on the next read (lib/duels expireIfStale).
   */
  disconnectedAt DateTime?

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([duelId, userId])
  @@index([userId])
}

// ── Community: stories/status posts, achievement shares, comments, follows ──

model Post {
  id                String        @id @default(cuid())
  userId            String
  // "status" (story/life post) | "achievement" (shared solve) | "question" (help
  // request pinned to a problem/bug) | "poll"
  type              String        @default("status")
  visibility        String        @default("public") // "public" | "followers" | "private"
  content           String        @db.Text
  meta              Json          @default("{}") // achievement payload: { kind: "problem"|"bug", slug?, challengeId?, title, difficulty?, xp? }; poll: { poll: { options: string[] } }; question: { ask: { slug?, challengeId?, title? } }
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  // Set the first time the author edits, so the card can say "edited"
  editedAt          DateTime?
  // Questions: the comment the asker accepted as the answer
  resolvedCommentId String?
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments          PostComment[]
  likes             PostLike[]
  tags              PostTag[]
  saves             SavedPost[]
  pollVotes         PollVote[]
  reports           PostReport[]

  @@index([createdAt])
  @@index([userId, createdAt])
  // Interview experiences (services/interview-experiences.ts): list, count and
  // sitemap all filter type + visibility and sort by createdAt; they walked
  // [createdAt] across every post to find the few experiences.
  @@index([type, visibility, createdAt])
}

model PostComment {
  id        String            @id @default(cuid())
  postId    String
  userId    String
  content   String            @db.Text
  // Threading is one level deep. Deliberately a plain column rather than a
  // self-relation: MySQL handles a self-referencing FK badly when the parent
  // post cascades, and the reply tree is assembled in the route anyway.
  parentId  String?
  createdAt DateTime          @default(now())
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     PostCommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model PostCommentLike {
  id        String      @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime    @default(now())
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

// Bookmarks — "read it later", private to the saver.
model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

// One vote per person per poll; the options live in Post.meta.poll.options.
model PollVote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  option    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

// Moderation queue: one report per person per post.
model PostReport {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  reason    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tag    String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, tag])
  @@index([tag])
}

// Per-user interest profile: which tags this user engages with (implicit signals)
model TagAffinity {
  id        String   @id @default(cuid())
  userId    String
  tag       String
  score     Float    @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
}

/// What candidates think: a star rating with optional quick-pick tags and a
/// comment, either about the platform (prompted every few days while they are
/// active, never inside a problem or an interview) or about one interview
/// (asked on its report). See routes/feedback.ts and services/feedback.ts.
/// An honour given by hand to an account — the founding members first
/// (2026-10-09, the owner's ask). The kinds and everything they say and give
/// are a template in code (lib/honours.ts HONOURS); a row only records that
/// this account holds one, and what has happened since: the celebration
/// shown (once per account, not per browser — the point of storing it), the
/// mail sent, and the LinkedIn clicks the owner asked to see in /admin.
/// Granted by scripts/grant-honour.ts or the admin panel's Honours tab.
model Honour {
  id                  String    @id @default(cuid())
  userId              String
  /// A key of lib/honours.ts HONOURS ("founding_member").
  kind                String    @db.VarChar(32)
  /// Who granted it (the admin's email, or "script").
  grantedBy           String?   @db.VarChar(191)
  grantedAt           DateTime  @default(now())
  /// When the celebration first opened for the holder, on any device.
  celebratedAt        DateTime?
  /// When the honour mail was accepted by the provider; null = not sent.
  mailedAt            DateTime?
  /// "Post on LinkedIn" — first click and how many.
  linkedinPostAt      DateTime?
  linkedinPosts       Int       @default(0)
  /// "Add to LinkedIn profile" (the certification form) — first click and how many.
  linkedinProfileAt   DateTime?
  linkedinProfiles    Int       @default(0)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([kind, grantedAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  /// "platform" | "interview"
  kind      String
  /// Whole stars, 1–5. Null on an "honour" note (lib/honours.ts), where the
  /// stars are optional — a founding member asked for their thoughts owes
  /// no score, and a made-up 5 would skew the platform average.
  rating    Int?
  comment   String?  @db.Text
  /// Phrases picked in the dialog.
  tags      Json     @default("[]")
  /// The MockInterviewSession rated, for kind "interview". Kept as a plain id
  /// so a rating outlives the session row it described.
  sessionId String?
  /// Where the platform prompt was answered.
  path      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "Last platform rating for this user" and "is this interview rated".
  @@index([userId, kind, createdAt])
  @@index([sessionId])
}

/// Aptitude preparation: one multiple-choice question with its hints, worked
/// solution and the idea behind it. Content is authored in
/// scripts/aptitude-data and upserted by slug (scripts/seed-aptitude.ts), so
/// the rows are the catalogue, not user data.
model AptitudeQuestion {
  id            String            @id @default(cuid())
  slug          String            @unique
  /// "quantitative" | "logical" | "verbal" | "data-interpretation"
  category      String
  /// Topic slug within the category, e.g. "percentages".
  topic         String
  title         String
  /// Markdown. Tables are GFM.
  prompt        String            @db.Text
  /// Markdown strings, in display order.
  options       Json
  /// Index into options.
  answer        Int
  /// "easy" | "medium" | "hard"
  difficulty    String
  /// Progressive hints, weakest first.
  hints         Json
  /// Markdown, step by step.
  solution      String            @db.Text
  /// The idea or shortcut the question is really testing.
  approach      String            @db.Text
  tags          Json              @default("[]")
  /// A sensible pace for this question, in seconds.
  timeTargetSec Int               @default(90)
  orderIndex    Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  attempts      AptitudeAttempt[]

  @@index([category, topic, orderIndex])
  @@index([topic, difficulty])
}

/// One answer to an aptitude question. `selected` is null when the candidate
/// asked for the solution without answering.
model AptitudeAttempt {
  id         String           @id @default(cuid())
  userId     String
  questionId String
  selected   Int?
  correct    Boolean
  timeSec    Int?
  usedHints  Int              @default(0)
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   AptitudeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Progress per topic and "is this one solved" both read the user's rows.
  @@index([userId, questionId, createdAt])
  @@index([userId, createdAt])
}

/// A company's placement test pattern. The rows are content, seeded from
/// scripts/mock-test-data; a sitting draws its paper from the aptitude bank
/// according to each section's blueprint, so one pattern yields a fresh paper
/// every time.
model MockTest {
  id              String            @id @default(cuid())
  slug            String            @unique
  /// "TCS", "Infosys", "Amazon".
  company         String
  /// "TCS NQT — Ninja".
  name            String
  /// "service" | "product" | "generic"
  family          String            @default("service")
  blurb           String            @db.Text
  /// Markdown shown before the clock starts.
  instructions    String            @db.Text
  /// Cached sum of the section durations.
  durationSec     Int
  totalQuestions  Int
  /// Marks lost per wrong answer; 0 where the real test has none.
  negativeMark    Float             @default(0)
  /// A section cannot be revisited once left, as in the real thing.
  sectionalTiming Boolean           @default(true)
  isAdaptive      Boolean           @default(false)
  /// Short chips for the card: "No negative marking", "Sectionally timed".
  highlights      Json              @default("[]")
  /// Where the pattern came from, shown in small print.
  sourceNote      String?           @db.Text
  difficulty      String            @default("medium")
  orderIndex      Int               @default(0)
  published       Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sections        MockTestSection[]
  attempts        MockAttempt[]

  @@index([published, family, orderIndex])
}

/// One timed section of a pattern, and the rule for filling it.
model MockTestSection {
  id               String   @id @default(cuid())
  testId           String
  /// Stable within the test, e.g. "numerical-ability".
  key              String
  name             String
  orderIndex       Int
  durationSec      Int
  questionCount    Int
  instructions     String?  @db.Text
  /// "mcq" draws from the aptitude bank; "coding" draws from the problem
  /// catalogue and is graded on test cases passed.
  kind             String   @default("mcq")
  /// What one question in this section is worth. A coding problem is worth
  /// far more than a multiple-choice question, as it is in the real papers.
  marksPerQuestion Float    @default(1)
  /// Draw rules: [{ topics?, category?, difficulty?, count }].
  blueprint        Json
  test             MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, key])
  @@index([testId, orderIndex])
}

/// One sitting. The paper is fixed at the start and the deadlines are the
/// server's, so a reload or a closed tab cannot buy extra time.
model MockAttempt {
  id             String           @id @default(cuid())
  userId         String
  testId         String
  /// "in-progress" | "submitted" | "expired" | "terminated" (ended by the
  /// proctoring — see BREACH_LIMIT in lib/skill-tests.ts)
  status         String           @default("in-progress")
  /// "<userId>:<testId>" while the sitting is live, null once it is closed.
  ///
  /// The rule this enforces is "one attempt in progress per person per test".
  /// It used to be enforced by locking the candidate's User row and re-reading
  /// inside a transaction — a per-user mutex held across three round trips,
  /// which anything else touching that user (a duel payout, XP from a solve)
  /// had to queue behind. MySQL has no partial indexes, so the condition is
  /// carried in the value instead: a live sitting writes the pair, a closed
  /// one writes null, and nulls do not collide in a unique index. Starting a
  /// test is then a plain insert whose duplicate-key error *is* the answer.
  ///
  /// Written in exactly two places — the insert in POST /:slug/start and the
  /// guarded close in finishAttempt. Anything else that ends a sitting must
  /// clear it too, or that test can never be started again.
  activeKey      String?          @unique @db.VarChar(80)
  startedAt      DateTime         @default(now())
  /// Hard stop for the whole paper.
  expiresAt      DateTime
  /// Deadline for the section in progress, when the test is sectionally timed.
  sectionEndsAt  DateTime?
  currentSection Int              @default(0)
  submittedAt    DateTime?
  /// The paper as drawn: [{ key, name, durationSec, questionIds }].
  paper          Json
  score          Float?
  maxScore       Float?
  correctCount   Int?
  wrongCount     Int?
  skippedCount   Int?
  /// Per-section marks, accuracy and time, computed once at submit.
  sectionScores  Json?
  /// The proctoring's counters, as on SkillAttempt: { breaches, paste, and
  /// one per breach cause }. Placement sittings are proctored since 2026-10-05.
  signals        Json             @default("{}")
  test           MockTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        MockAnswer[]
  codeAnswers    MockCodeAnswer[]

  @@index([userId, status, startedAt])
  @@index([testId, submittedAt])
  // The attempt list is "all of mine, newest first" with no status filter.
  @@index([userId, startedAt])
}

/// One answer within a sitting. Upserted as the candidate moves about, so the
/// row survives a refresh.
model MockAnswer {
  id           String      @id @default(cuid())
  attemptId    String
  questionId   String
  sectionIndex Int
  selected     Int?
  correct      Boolean     @default(false)
  /// The candidate flagged it to come back to.
  marked       Boolean     @default(false)
  /// Seconds spent on this question, accumulated client-side.
  timeSec      Int         @default(0)
  updatedAt    DateTime    @updatedAt
  attempt      MockAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId, sectionIndex])
}

/// One coding problem within a sitting: the candidate's working copy and the
/// best result they have reached on it. Deliberately separate from CodeDraft
/// and Submission — a mock sitting must never disturb the drafts or the
/// submission history of ordinary practice.
model MockCodeAnswer {
  id           String      @id @default(cuid())
  attemptId    String
  problemId    String
  sectionIndex Int
  language     String      @default("python")
  code         String      @db.MediumText
  /// The best run so far, which is what the sitting is graded on.
  verdict      String?
  passedCases  Int         @default(0)
  totalCases   Int         @default(0)
  runtimeMs    Int?
  memoryKb     Int?
  /// How many times the candidate submitted this problem.
  submissions  Int         @default(0)
  timeSec      Int         @default(0)
  updatedAt    DateTime    @updatedAt
  attempt      MockAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problem      Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([attemptId, problemId])
  @@index([attemptId, sectionIndex])
}

// ── Skill tests: one skill at one level, certified ───────────────────────────

/// A skill test ("Java · Intermediate"). Content, seeded from
/// scripts/skill-test-data. It runs on the placement-test engine's rules
/// (lib/mock-tests.ts: a paper drawn per sitting, server-owned deadlines,
/// sections taken in order) but keeps its own tables, because two things are
/// different in kind: its multiple-choice questions come from a private bank
/// whose key never leaves the server — not during a sitting and not in the
/// result, since a credential is only worth what a stranger cannot look up —
/// and a passing sitting issues a SkillCredential.
model SkillTest {
  id                 String             @id @default(cuid())
  slug               String             @unique @db.VarChar(80)
  /// lib/skill-catalog.ts SkillId.
  skill              String             @db.VarChar(40)
  /// "basic" | "intermediate" | "advanced"
  level              String             @db.VarChar(20)
  title              String
  blurb              String             @db.Text
  /// Markdown shown before the clock starts.
  instructions       String             @db.Text
  /// Judge languages the coding section accepts; [] = any.
  languages          Json               @default("[]")
  durationSec        Int
  totalQuestions     Int
  passPercent        Int                @default(60)
  distinctionPercent Int                @default(85)
  /// Days after a sitting closes before the test can be sat again.
  cooldownDays       Int                @default(7)
  /// How long a credential from this test stays valid.
  validityMonths     Int                @default(24)
  orderIndex         Int                @default(0)
  published          Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  sections           SkillTestSection[]
  attempts           SkillAttempt[]
  credentials        SkillCredential[]

  @@unique([skill, level])
  @@index([published, orderIndex])
}

/// One timed section of a skill test and the rule for filling it — the same
/// shape as MockTestSection, read by the same drawPaper. An "mcq" section's
/// blueprint is pinned to its pool (`category: "<skill>:<level>"`), so it
/// can only ever draw from SkillQuestion rows of that skill and level.
model SkillTestSection {
  id               String    @id @default(cuid())
  testId           String
  key              String    @db.VarChar(40)
  name             String
  orderIndex       Int
  durationSec      Int
  questionCount    Int
  instructions     String?   @db.Text
  /// "mcq" | "coding"
  kind             String    @default("mcq") @db.VarChar(10)
  marksPerQuestion Float     @default(1)
  blueprint        Json
  test             SkillTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, key])
  @@index([testId, orderIndex])
}

/// The private multiple-choice bank. Rows are content keyed by a stable key
/// from the bank files; a question that leaves the files is deactivated,
/// never deleted, because a sitting in progress may hold its id.
model SkillQuestion {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(80)
  skill       String   @db.VarChar(40)
  level       String   @db.VarChar(20)
  topic       String   @db.VarChar(60)
  /// "single" | "multi" (all-or-nothing on the exact set).
  kind        String   @default("single") @db.VarChar(10)
  /// Markdown.
  prompt      String   @db.Text
  options     Json
  /// Indices of the correct options. Never serialised to a client.
  answer      Json
  /// Why the key is right. For reviewers; never shown to a candidate.
  explanation String   @db.Text
  /// An output-prediction question the judge has proved (seed --run).
  checked     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([skill, level, active])
}

/// One sitting of a skill test. Mirrors MockAttempt — see the comments there
/// for `activeKey` and the deadlines — plus the grade a credential is issued
/// on and the integrity signals the client reported.
model SkillAttempt {
  id             String            @id @default(cuid())
  userId         String
  testId         String
  /// "in-progress" | "submitted" | "expired"
  status         String            @default("in-progress") @db.VarChar(16)
  /// "<userId>:<testId>" while live, null once closed (one live sitting per
  /// person per test, enforced by the unique index; MockAttempt explains why).
  activeKey      String?           @unique @db.VarChar(80)
  startedAt      DateTime          @default(now())
  expiresAt      DateTime
  sectionEndsAt  DateTime?
  currentSection Int               @default(0)
  submittedAt    DateTime?
  /// The paper as drawn: [{ key, name, durationSec, kind, marksPerQuestion, questionIds }].
  paper          Json
  score          Float?
  maxScore       Float?
  percent        Int?
  /// "distinction" | "pass" | "fail", set at grading.
  band           String?           @db.VarChar(16)
  correctCount   Int?
  wrongCount     Int?
  skippedCount   Int?
  sectionScores  Json?
  /// Per-topic marks: [{ topic, total, correct }].
  topicScores    Json?
  /// Counters the runner reported: { tabHidden, paste, fullscreenExit }.
  signals        Json              @default("{}")
  /// Why grading flagged the sitting for review; [] when it did not.
  flags          Json              @default("[]")
  test           SkillTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        SkillAnswer[]
  codeAnswers    SkillCodeAnswer[]

  // The cooldown and the detail page read one person's sittings of one test.
  @@index([userId, testId, startedAt])
  @@index([userId, startedAt])
  // Admin review: recent sittings of a test.
  @@index([testId, submittedAt])
}

/// One multiple-choice answer within a sitting. `selected` is the option
/// indices chosen ([] or null = unanswered); `correct` is judged on save and
/// never returned while the sitting is live.
model SkillAnswer {
  id           String       @id @default(cuid())
  attemptId    String
  questionId   String
  sectionIndex Int
  selected     Json?
  correct      Boolean      @default(false)
  marked       Boolean      @default(false)
  timeSec      Int          @default(0)
  updatedAt    DateTime     @updatedAt
  attempt      SkillAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId, sectionIndex])
}

/// One coding problem within a sitting — MockCodeAnswer's twin, plus how
/// closely the best submission matches the problem's published editorial
/// solution in the same language (0–1), which grading flags above a bar.
model SkillCodeAnswer {
  id           String       @id @default(cuid())
  attemptId    String
  problemId    String
  sectionIndex Int
  language     String       @default("python") @db.VarChar(20)
  code         String       @db.MediumText
  verdict      String?      @db.VarChar(32)
  passedCases  Int          @default(0)
  totalCases   Int          @default(0)
  runtimeMs    Int?
  memoryKb     Int?
  submissions  Int          @default(0)
  timeSec      Int          @default(0)
  similarity   Float?
  updatedAt    DateTime     @updatedAt
  attempt      SkillAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problem      Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([attemptId, problemId])
  @@index([attemptId, sectionIndex])
}

/// A credential: the account passed this test. One row per (account, test) —
/// a later, better sitting raises its band and renews it in place, so the
/// public code printed on a certificate never changes. `code` is what
/// /verify/<code> resolves; it is random, never derived from an id.
model SkillCredential {
  id            String    @id @default(cuid())
  /// "CK-7H3K-9QXM": Crockford base32, no I/L/O/U.
  code          String    @unique @db.VarChar(16)
  userId        String
  testId        String
  /// Copied from the test so an author payload can draw the frame without
  /// a second join.
  skill         String    @db.VarChar(40)
  level         String    @db.VarChar(20)
  /// "pass" | "distinction"
  band          String    @db.VarChar(16)
  percent       Int
  /// The sitting that earned the standing shown.
  attemptId     String
  issuedAt      DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation("credentialOwner", fields: [userId], references: [id], onDelete: Cascade)
  test          SkillTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  wornBy        User[]    @relation("wornCredential")

  @@unique([userId, testId])
  @@index([userId, issuedAt])
}

// ── Daily contest: one kata a day, ranked like a contest ─────────────────────

/// The kata of one UTC day. A row is created the first time anyone asks for
/// that day (see services/daily-contest.ts: the pick is a deterministic hash
/// of the date over the catalogue, so two instances racing produce the same
/// row and the unique on `date` settles it). `date` is "YYYY-MM-DD": a string
/// sorts and ranges the way a day does, without the timezone shifts a
/// DateTime column invites.
model DailyContest {
  id         String              @id @default(cuid())
  date       String              @unique @db.VarChar(10)
  problemId  String
  difficulty String
  createdAt  DateTime            @default(now())
  /// When the day's XP was paid to its solvers (services/daily-contest-rewards.ts).
  /// Null on today's contest and on a closed day the payout has not reached yet.
  settledAt  DateTime?
  problem    Problem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  entries    DailyContestEntry[]

  /// "Not used in the last year" when picking a kata reads this by problem.
  @@index([problemId, date])
}

/// One warrior's sitting of one day's kata. The clock starts when the
/// workspace is opened on the contest day (startedAt) and stops at the first
/// accepted submission; every rejected one before it adds five minutes, the
/// way a contest penalises wrong submissions. `date` is copied from the
/// contest so streaks and month standings read one index and never join.
model DailyContestEntry {
  id            String       @id @default(cuid())
  contestId     String
  userId        String
  date          String       @db.VarChar(10)
  startedAt     DateTime     @default(now())
  solvedAt      DateTime?
  timeTakenSec  Int?
  wrongAttempts Int          @default(0)
  /// timeTakenSec + 300 × wrongAttempts — the day's ranking key, lower first.
  penaltySec    Int?
  /// 3 / 4 / 5 for easy / medium / hard, awarded on solve; the season key.
  points        Int          @default(0)
  /// The XP this sitting was paid when its day closed — the solve's 20, plus
  /// 15 / 10 for the day's fastest and second fastest. Null until then, and
  /// for ever on a sitting that was never solved. Written in the same
  /// transaction as the User increment and only over a null: this column is
  /// what makes the payout once-only.
  rewardXp      Int?
  contest       DailyContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  /// Streak and calendar: the user's days, solved or not, in date order.
  @@index([userId, date])
  /// The day's board and the rank-of-me count both order solvers by penalty.
  @@index([contestId, penaltySec])
  /// Month standings sum points over a date range.
  @@index([date, points])
}

// ── Telemetry: what breaks, and what gets used ───────────────────────────
//
// Both tables are written fire-and-forget and read only by the admin panel.
// They are our own rather than a hosted error tracker for two reasons: the
// SPA's CSP whitelists exactly one origin for connect-src (the API), so a
// third-party ingest would mean opening it; and a row per occurrence costs
// nothing while the numbers are small, which they are. If volume ever makes
// this the wrong shape, the write sites are lib/telemetry.ts on the API and
// lib/telemetry.ts in the SPA — two files, not a codebase.

/// One error, wherever it happened: an unhandled route error or a 5xx on the
/// API, an uncaught exception or a render crash in the browser.
model ErrorReport {
  id          String   @id @default(cuid())
  /// "api" | "web" | "android"
  source      String   @db.VarChar(16)
  /// "unhandled" | "response" | "rejection" | "window" | "render" | "chunk"
  kind        String   @db.VarChar(24)
  message     String   @db.Text
  stack       String?  @db.Text
  /// Route or page the error surfaced on.
  path        String?  @db.VarChar(512)
  /// SHA-1 of source + kind + the message with numbers and ids stripped +
  /// the first stack frame. Groups repeats of the same defect, which is what
  /// the panel lists; an individual occurrence is one row under it.
  fingerprint String   @db.VarChar(40)
  /// Plain column, not a relation: an error must outlive the account it hit.
  userId      String?
  userAgent   String?  @db.VarChar(512)
  /// Deploy identifier when the client knows one (the Vercel commit sha).
  release     String?  @db.VarChar(64)
  /// Anything else worth keeping: HTTP status, the component stack, a request id.
  meta        Json?
  createdAt   DateTime @default(now())

  /// The panel: groups over a window, then that group's recent occurrences.
  @@index([createdAt])
  @@index([fingerprint, createdAt])
  @@index([source, createdAt])
  // userId is a plain column, not a relation, so MySQL never indexed it: the
  // admin user page's recent errors and account deletion's updateMany (which
  // nulls it) were full scans of a table of TEXT columns.
  @@index([userId, createdAt])
}

/// One thing a person did: a page view, a submit, a checkout started.
model AppEvent {
  id        String   @id @default(cuid())
  /// Snake-case verb, e.g. "page_view", "submit", "checkout_start".
  name      String   @db.VarChar(64)
  /// Plain column (see ErrorReport.userId).
  userId    String?
  /// Anonymous per-tab id, so a visitor's steps line up before they sign in.
  sessionId String?  @db.VarChar(40)
  /// Where it happened, with ids replaced by their route pattern
  /// ("/challenges/:slug") so a hundred problems are one row on the chart.
  path      String?  @db.VarChar(512)
  /// "web" | "android" | "api" (server-side events such as a granted subscription)
  platform  String   @default("web") @db.VarChar(16)
  props     Json?
  createdAt DateTime @default(now())

  /// Daily actives are a DISTINCT over (userId) in a date range; feature use
  /// is a GROUP BY name in the same range.
  @@index([createdAt])
  @@index([name, createdAt])
  @@index([userId, createdAt])
}

/// One session token that was signed out before it expired.
///
/// A JWT cannot be taken back once handed out: signing out used to clear the
/// cookie and the SPA's copy and nothing more, so a token that had leaked
/// stayed good for its full thirty days. Every token now carries a `jti`, and
/// signing out writes it here until the token would have expired anyway —
/// after that the row is dead weight and the sweep job removes it. Read
/// through the per-user revocation cache (lib/session-revocation.ts), never
/// once per request.
model RevokedSession {
  jti       String   @id @db.VarChar(64)
  userId    String
  /// The token's own `exp`; the row is pointless after it.
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One browser that agreed to system notifications for an account (Web
/// Push, lib/push.ts): what the browser's push service handed it — the
/// endpoint to POST to and the two keys a payload is encrypted with. A row
/// per browser, so the switch on the profile is per device. The endpoint is
/// the identity (a browser re-subscribing gets the same one back, and the
/// row moves to whichever account turned it on last). A push service that
/// answers 404/410 has dropped the subscription and the row goes with it.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  /// ≤ 700 characters keeps the unique index under InnoDB's 3,072-byte key at utf8mb4.
  endpoint   String   @unique @db.VarChar(700)
  p256dh     String   @db.VarChar(200)
  auth       String   @db.VarChar(64)
  createdAt  DateTime @default(now())
  /// The last push the service accepted for it.
  lastPushAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One execution of a scheduled job (lib/scheduler.ts).
///
/// The id is `<job>:<period>` — "streak_at_risk:2026-09-11" — and inserting it
/// is how a run is claimed: the primary key refuses a second instance that
/// wakes in the same window, so the table is both the lock and the log. No
/// Redis needed, and a restart mid-window does not send everything twice.
model JobRun {
  id         String    @id @db.VarChar(80)
  job        String    @db.VarChar(40)
  period     String    @db.VarChar(32)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// What the run did, for the panel: rows notified, mails sent, and so on.
  result     Json?
  error      String?   @db.Text

  @@index([job, startedAt])
}

/// The site assistant's conversation with an account, one row per turn.
/// Stored so the dock reopens where it left off, and so the daily allowance
/// is a count of rows like every quota in services/entitlements.ts — never
/// a counter. "Clear conversation" hides rows rather than deleting them:
/// a deleted row would hand the allowance back.
model AssistantMessage {
  id        String   @id @default(cuid())
  userId    String
  /// "user" | "assistant"
  role      String   @db.VarChar(12)
  content   String   @db.Text
  cleared   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// The DSA roadmap's tiers: the four bands the road is drawn in, in order.
/// Authored content, seeded by scripts/seed-roadmap.ts from
/// scripts/roadmap-data.ts (the same pattern as the catalogue and the bug
/// hunts); `key` is the stable handle the seed upserts by.
model RoadmapTier {
  id               String         @id @default(cuid())
  key              String         @unique @db.VarChar(40)
  title            String
  blurb            String         @db.Text
  position         Int
  /// What the chest at the tier's end holds when every stage in it is
  /// cleared: XP (paid to `xp` and `rating` alike) and bonus mock-interview
  /// sessions, spent only once the plan's weekly allowance is used up.
  /// Content, like the title — set in scripts/roadmap-data.ts.
  rewardXp         Int            @default(0)
  interviewCredits Int            @default(0)
  stages           RoadmapStage[]

  @@index([position])
}

/// A tier's chest, opened: written once per (user, tier) when every stage of
/// the tier is cleared, by services/roadmap.ts. Standing on the road is never
/// stored — it is derived from Submission rows — but this row has to be,
/// because the XP it paid cannot be derived twice: the unique pair is what
/// makes the payout one-shot, and the row is the badge on the profile and
/// the claim behind a shared win. Keyed by the tier's stable `key`, not its
/// id, and with no relation to RoadmapTier: a re-seed that prunes a tier must
/// not take an earned reward with it.
model RoadmapReward {
  id               String   @id @default(cuid())
  userId           String
  tierKey          String   @db.VarChar(40)
  xp               Int
  /// Bonus mock interviews this chest granted. The balance is derived, never
  /// counted down: granted here, spent by MockInterviewSession rows opened
  /// `onCredit` that were actually sat (services/entitlements.ts).
  interviewCredits Int      @default(0)
  earnedAt         DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tierKey])
}

/// One stage of the roadmap: a handful of problems, cleared when `required`
/// of them have an ACCEPTED submission, and open only once the stage before
/// it (by `position`) is cleared. Progress is never stored here — it is
/// derived from Submission rows by services/roadmap.ts. `key` is stable
/// (notification types and client node keys use it); `position` orders the
/// road and may be renumbered by a re-seed.
model RoadmapStage {
  id          String                @id @default(cuid())
  key         String                @unique @db.VarChar(60)
  title       String
  blurb       String                @db.Text
  icon        String                @db.VarChar(40)
  position    Int
  required    Int
  isPublished Boolean               @default(true)
  tierId      String
  tier        RoadmapTier           @relation(fields: [tierId], references: [id], onDelete: Cascade)
  problems    RoadmapStageProblem[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([isPublished, position])
}

/// A problem's place in a stage. A problem sits in at most one stage — the
/// road never asks for the same solve twice — so `problemId` is unique on
/// its own as well as with the stage.
model RoadmapStageProblem {
  id        String       @id @default(cuid())
  stageId   String
  problemId String       @unique
  position  Int
  stage     RoadmapStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([stageId, problemId])
  @@index([stageId, position])
}

/// A study plan: one language's syllabus, seeded from scripts/study-plans
/// (the roadmap pattern — authored in TypeScript and Markdown, reviewed
/// there, served from these tables). `language` is the judge language its
/// exercises run as; `runtime` names the toolchain the content targets
/// ("OpenJDK 18 on Paiza"), because which features compile is content too.
model StudyTrack {
  id          String        @id @default(cuid())
  key         String        @unique @db.VarChar(40)
  title       String
  blurb       String        @db.Text
  language    String        @db.VarChar(20)
  runtime     String        @db.VarChar(80)
  position    Int
  isPublished Boolean       @default(true)
  modules     StudyModule[]

  @@index([isPublished, position])
}

/// A chapter of a track. `key` is global ("java:jvm") and stable — progress
/// rows and notification types use it; `slug` is the URL segment, unique
/// within the track. The overview is the module's own page and the PDF's
/// cover.
model StudyModule {
  id       String        @id @default(cuid())
  key      String        @unique @db.VarChar(80)
  slug     String        @db.VarChar(60)
  trackId  String
  track    StudyTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title    String
  blurb    String        @db.Text
  icon     String        @db.VarChar(40)
  overview String        @db.Text
  position Int
  lessons  StudyLesson[]

  @@unique([trackId, slug])
  @@index([trackId, position])
}

/// One lesson: the whole text as Markdown, its exercises and its quiz. A
/// `kind` of "test" is the module's checkpoint — a bigger quiz and two
/// exercises, cleared at `passMark` percent. Exercise reference solutions
/// and quiz answers live here and are never sent to the client: the
/// service grades (services/study-plans.ts).
model StudyLesson {
  id        String      @id @default(cuid())
  key       String      @unique @db.VarChar(120)
  slug      String      @db.VarChar(80)
  moduleId  String
  module    StudyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  /// "lesson" | "test"
  kind      String      @db.VarChar(12)
  position  Int
  minutes   Int
  body      String      @db.MediumText
  /// [{ title, prompt, starter, solution, hints[], cases[{stdin, expected, hidden?}] }]
  exercises Json        @default("[]")
  /// [{ prompt, options[], answer, explanation }]
  quiz      Json        @default("[]")
  /// Percent of the quiz needed to clear a test; null for a lesson.
  passMark  Int?
  xp        Int         @default(10)
  /// What search engines are told about the lesson and the questions the
  /// page answers: { title, description, question, answer, faq[{q, a}] }
  /// (scripts/study-plans/dsl.ts LessonSeo). Null until a seed writes it —
  /// the page then falls back to the lesson's title and opening.
  seo       Json?

  @@index([moduleId, position])
}

/// An account's plan on a track: when it started and the pace chosen. The
/// schedule is arithmetic over these two and the lesson count — "today's
/// lesson" and "two behind" are computed, never stored. `completedAt` is
/// the one-shot for the track's finishing XP.
model StudyEnrollment {
  id          String    @id @default(cuid())
  userId      String
  trackKey    String    @db.VarChar(40)
  startedAt   DateTime  @default(now())
  paceDays    Int
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackKey])
}

/// What an account has done on one lesson. Unlike the roadmap, none of this
/// can be derived — reading has no judge — so it is written, one row per
/// (user, lesson), keyed by the lesson's stable key so a re-seed keeps it.
/// `completedAt` is set once, when every part is done, and pays the XP.
model StudyLessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonKey       String    @db.VarChar(120)
  readAt          DateTime?
  /// Best quiz so far: correct answers and the quiz's size when it was taken.
  quizCorrect     Int?
  quizTotal       Int?
  quizAt          DateTime?
  /// Exercises passed, by index into the lesson's list.
  exercisesPassed Json      @default("[]")
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonKey])
  @@index([userId, updatedAt])
}

/// Every judged exercise submission, kept the way Submission rows are.
model StudyExerciseSubmission {
  id          String   @id @default(cuid())
  userId      String
  lessonKey   String   @db.VarChar(120)
  exercise    Int
  code        String   @db.MediumText
  language    String   @db.VarChar(20)
  verdict     String   @db.VarChar(30)
  passed      Int
  total       Int
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lessonKey, submittedAt])
}

/// An uploaded resume and its working copy.
///
/// The file itself is not kept: the platform has no object store and the API
/// host's disk is ephemeral, so the extracted text (`rawText`) and the
/// structured, editable `content` are the artifacts — the export routes
/// regenerate a document from `content`. `storageKey` stays for a deployment
/// that adds a store (lib/resume-files.ts `ResumeFileStore`). `layout` holds
/// what the extractor learned about the original file (pages, columns,
/// tables, images, header contact) that the ATS check reads and an edited
/// copy can no longer reveal.
model Resume {
  id               String             @id @default(cuid())
  userId           String
  title            String             @db.VarChar(120)
  originalFilename String             @db.VarChar(255)
  mimeType         String             @db.VarChar(100)
  fileSize         Int
  fileSha256       String             @db.VarChar(64)
  storageKey       String?            @db.VarChar(255)
  rawText          String             @db.MediumText
  layout           Json
  content          Json
  /// "heuristic" | "ai" | "edited" — who last shaped `content`. An AI
  /// restructure only ever replaces a heuristic parse, never an edit.
  contentSource    String             @db.VarChar(12)
  targetRole       String?            @db.VarChar(120)
  company          String?            @db.VarChar(120)
  jobDescription   String?            @db.Text
  latestAnalysisId String?
  latestScore      Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions         ResumeVersion[]
  analyses         ResumeAnalysis[]
  suggestions      ResumeSuggestion[]

  @@index([userId, updatedAt])
}

/// A named snapshot: the exact editable state, the target it was aimed at
/// and the analysis it had at the time, so a version can be restored or
/// compared to the current copy.
model ResumeVersion {
  id             String   @id @default(cuid())
  resumeId       String
  userId         String
  name           String   @db.VarChar(120)
  content        Json
  targetRole     String?  @db.VarChar(120)
  company        String?  @db.VarChar(120)
  jobDescription String?  @db.Text
  analysis       Json?
  score          Int?
  createdAt      DateTime @default(now())
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
  @@index([userId, createdAt])
}

/// One run of the analysis pipeline. The row is the job: `status` moves
/// queued → running → done|failed and `stage` names the step under way, so
/// the client polls real progress. `contentSnapshot` is what was scored —
/// the working copy keeps changing — and `result` is the full structured
/// report (lib/resume-scoring.ts AnalysisResult).
model ResumeAnalysis {
  id              String    @id @default(cuid())
  resumeId        String
  userId          String
  status          String    @db.VarChar(12)
  stage           String    @db.VarChar(24)
  error           String?   @db.Text
  targetRole      String?   @db.VarChar(120)
  company         String?   @db.VarChar(120)
  jobDescription  String?   @db.Text
  contentSnapshot Json
  result          Json?
  score           Int?
  /// "ok" | "unavailable" | null while running — whether the model's part of
  /// the report landed or the deterministic fallback stood in.
  aiStatus        String?   @db.VarChar(12)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  resume          Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Every change the model proposed, and what the person did with it.
/// `path` addresses the field in `content` (e.g. "experience.0.bullets.2",
/// "summary"); nothing is applied until the person accepts it.
model ResumeSuggestion {
  id         String    @id @default(cuid())
  resumeId   String
  userId     String
  analysisId String?
  /// "bullet" | "summary" | "optimize"
  kind       String    @db.VarChar(16)
  mode       String?   @db.VarChar(24)
  path       String    @db.VarChar(80)
  original   String    @db.Text
  suggested  String    @db.Text
  rationale  String    @db.Text
  /// "pending" | "accepted" | "rejected"
  status     String    @db.VarChar(10)
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  resume     Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

/// A win's shareable picture (2026-09-25). LinkedIn, WhatsApp and X take
/// text through their share links but never a file, so the picture reaches
/// them the one way they all read: as the link preview (Open Graph image) of
/// the page the post links to, /share/<id> on the site. The PNG is drawn in
/// the browser (frontend components/community/share-image.ts), uploaded once
/// when the share dialog opens, and served back unsigned for the crawlers at
/// /api/share-cards/<id>/image.jpg (JPEG: a tenth of the PNG). The bytes live here rather than on disk:
/// the API's disk is ephemeral, there is no object store, and a card is
/// ~100 KB; an account keeps its newest few (services/share-cards.ts).
model ShareCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "problem" | "bug" | "roadmap" | "badge" | "honour"
  kind        String   @db.VarChar(16)
  title       String   @db.VarChar(200)
  difficulty  String?  @db.VarChar(20)
  /// Where "Solve it too" goes: a problem's slug, or nothing for a chest.
  /// A badge's id (`streak-7`, lib/badges) for a badge — it has no page —
  /// and an honour's kind (`founding_member`, lib/honours) for an honour.
  slug        String?  @db.VarChar(200)
  /// A bug hunt's id, for the hunt's own page.
  challengeId String?  @db.VarChar(40)
  xp          Int?
  image       Bytes    @db.MediumBlob
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ── CodeKairo Battles (battles.codekairo.com) ──────────────────────────
// Organizations host tournaments; players are ordinary CodeKairo accounts.
// services/battles.ts owns every rule; battles-rules.ts holds the pure ones.

/// A college, club, company or community that hosts tournaments.
model BattleOrg {
  id               String    @id @default(cuid())
  slug             String    @unique @db.VarChar(80)
  name             String    @db.VarChar(120)
  kind             String    @db.VarChar(16) // college | club | company | community
  website          String?   @db.VarChar(300)
  city             String?   @db.VarChar(80)
  about            String?   @db.Text
  /// Set by the site admin. Until then the org's tournaments cannot be
  /// published — anyone may create an org, so "IIT Bombay" must be checked
  /// by a person before students see it. An edit to a verified org clears it
  /// again: what players see must be what was checked.
  verifiedAt       DateTime?
  /// The details as the admin last verified them (battles-rules OrgSnapshot),
  /// so a re-verification shows what changed instead of asking for it all again.
  verifiedSnapshot Json?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members     BattleOrgMember[]
  tournaments Tournament[]

  // The admin's verification queue reads unverified orgs, oldest first.
  @@index([verifiedAt, createdAt])
  @@index([createdById])
}

model BattleOrgMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String   @db.VarChar(12) // owner | admin
  createdAt DateTime @default(now())

  org  BattleOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  // "My organizations" on the host dashboard.
  @@index([userId])
}

model Tournament {
  id                   String    @id @default(cuid())
  orgId                String
  slug                 String    @unique @db.VarChar(100)
  title                String    @db.VarChar(140)
  description          String?   @db.Text
  format               String    @db.VarChar(12) // knockout | icpc
  /// draft | published | review | cancelled. `review`: a published tournament
  /// the organizer edited, hidden like a draft until the site admin approves it.
  status               String    @default("draft") @db.VarChar(12)
  /// 1 for a knockout; 1–3 for an ICPC-style contest.
  teamSize             Int       @default(1)
  /// Most entries accepted (pending + approved); null = no limit.
  capacity             Int?
  registrationClosesAt DateTime
  startsAt             DateTime
  /// The contest's length (ICPC) or each match's (knockout).
  durationMinutes      Int
  /// Lower-cased email domains an entrant's address must end in; [] = any.
  allowedDomains       Json      @default("[]")
  /// Needed to register when set; shared by the organizer.
  inviteCode           String?   @db.VarChar(24)
  requiresApproval     Boolean   @default(false)
  /// ICPC: the public scoreboard stops updating this many minutes before the
  /// end (0 = never), until the organizer reveals the results.
  freezeMinutes        Int       @default(0)
  /// ICPC: when the organizer lifted the freeze and published final standings.
  resultsRevealedAt    DateTime?
  /// Knockout: when the bracket was drawn from the checked-in players (once, at the start).
  bracketAt            DateTime?
  /// Knockout: when the final was decided, and who won it.
  finishedAt           DateTime?
  championId           String?
  createdById          String
  publishedAt          DateTime?
  /// The settings as players last saw them approved — at publish, then at
  /// each approval (battles-rules TournamentSnapshot) — for the admin's diff.
  approvedSnapshot     Json?
  /// When an edit sent it to `review`; the admin's queue is oldest first.
  reviewRequestedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org         BattleOrg              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  problems    TournamentProblem[]
  teams       TournamentTeam[]
  entries     TournamentEntry[]
  submissions TournamentSubmission[]
  matches     TournamentMatch[]
  reminders   TournamentReminder[]

  // The public list: published, by start time.
  @@index([status, startsAt])
  @@index([orgId, createdAt])
}

/// A reminder email to a tournament's approved entrants: the two the
/// scheduler sends by itself, 24 hours and 1 hour before the start, and any
/// an organizer or a CodeKairo admin sends by hand
/// (services/tournament-reminders.ts). The row is the claim and the log.
/// `claim` is unique per tournament: `day@<start ms>` / `hour@<start ms>` for
/// the scheduled ones — once per start time, and again if the start moves —
/// and `manual@<ms>` for a button press.
model TournamentReminder {
  id           String    @id @default(cuid())
  tournamentId String
  claim        String    @db.VarChar(40)
  /// day | hour | manual
  kind         String    @db.VarChar(8)
  /// Who pressed the button; null for the scheduled ones.
  sentById     String?
  /// Entrants it was addressed to, and how many mails the provider accepted.
  recipients   Int       @default(0)
  mailed       Int       @default(0)
  createdAt    DateTime  @default(now())
  /// Set when the last mail was handed over; null while it is still sending.
  finishedAt   DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, claim])
  // The cooldown and the history read a tournament's reminders newest first.
  @@index([tournamentId, createdAt])
}

/// A tournament's problem set, in order. Hidden from players until it starts.
model TournamentProblem {
  tournamentId String
  problemId    String
  position     Int

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  problem    Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([tournamentId, problemId])
  @@index([problemId])
}

/// An ICPC-style team, entered by the organizer (uploaded, not self-formed).
model TournamentTeam {
  id           String   @id @default(cuid())
  tournamentId String
  name         String   @db.VarChar(80)
  createdAt    DateTime @default(now())

  tournament  Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  entries     TournamentEntry[]
  submissions TournamentSubmission[]

  @@unique([tournamentId, name])
}

/// One account's place in a tournament — a knockout player, or a member of
/// an uploaded ICPC team.
model TournamentEntry {
  id           String    @id @default(cuid())
  tournamentId String
  userId       String
  teamId       String?
  status       String    @default("pending") @db.VarChar(12) // pending | approved | rejected
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?
  /// Knockout: confirmed present in the hour before the start; only these are seeded.
  checkedInAt  DateTime?
  /// Knockout: 1 = best, by rating when the bracket was drawn.
  seed         Int?

  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       TournamentTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  // The organizer's registration list, filtered by status.
  @@index([tournamentId, status])
  // "My tournaments".
  @@index([userId])
  @@index([teamId])
}

/// One attempt in an ICPC contest: the team it scores for, and the ordinary
/// Submission it was (which is what credits the solver's main profile).
/// Recorded by the judge (services/contest.ts recordTournamentSubmission);
/// the standings are computed from these rows, never stored.
model TournamentSubmission {
  id           String   @id @default(cuid())
  tournamentId String
  /// The ICPC team it scores for; null for a knockout attempt (a player, no team).
  teamId       String?
  userId       String
  problemId    String
  submissionId String   @unique
  /// contest-rules ContestVerdict: accepted | wrong_answer | time_limit | runtime_error | compile_error
  verdict      String   @db.VarChar(16)
  submittedAt  DateTime

  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       TournamentTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem    Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submission Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // The standings read a contest's whole history in time order.
  @@index([tournamentId, submittedAt])
  // A team's own submission list in the contest room.
  @@index([teamId, submittedAt])
  // "Solved in a tournament" on the main site: this user, this problem.
  @@index([userId, problemId])
  @@index([problemId])
}

/// One knockout match: two players (or one and a bye), one problem, a clock.
/// Decided by the first accepted solution (the judge, services/knockout.ts),
/// or when time runs out by knockout-rules `timeoutWinner` over each side's
/// best result. The winner is written into the next round's match.
model TournamentMatch {
  id           String    @id @default(cuid())
  tournamentId String
  round        Int
  position     Int
  playerAId    String?
  playerBId    String?
  seedA        Int?
  seedB        Int?
  problemId    String?
  /// waiting (a player to come) | live | done
  status       String    @default("waiting") @db.VarChar(10)
  startedAt    DateTime?
  endsAt       DateTime?
  winnerId     String?
  /// solve | timeout | bye
  decidedBy    String?   @db.VarChar(10)
  decidedAt    DateTime?
  /// Each side's best test cases passed, out of how many, and when first reached.
  aPassed      Int       @default(0)
  bPassed      Int       @default(0)
  total        Int       @default(0)
  aBestAt      DateTime?
  bBestAt      DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerA    User?      @relation("matchPlayerA", fields: [playerAId], references: [id], onDelete: SetNull)
  playerB    User?      @relation("matchPlayerB", fields: [playerBId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, round, position])
  // The judge's lookup: this player's live match.
  @@index([playerAId, status])
  @@index([playerBId, status])
  // Settling the matches whose time ran out.
  @@index([tournamentId, status, endsAt])
}

/// A study cohort (Phase 9 of ADAPTIVE_COACH.md, §16): up to eight members
/// learning together towards one weekly goal. Joined only by its invite
/// code; never listed, never indexed, never on a profile. Progress is
/// derived from the members' accepted rows (lib/cohorts.ts) — nothing here
/// counts anything.
model Cohort {
  id         String          @id @default(cuid())
  name       String          @db.VarChar(60)
  ownerId    String
  /// "7H3K-9QXM" (lib/cohorts.ts inviteCode). Regenerating it kills the old one.
  inviteCode String          @unique @db.VarChar(12)
  /// The weekly goal: 1–2 skill keys from lib/skill-graph.ts (DSA, SQL or debugging) …
  goalSkills Json            @default("[]")
  /// … and the solves each member aims for in a week.
  goalTarget Int             @default(5)
  goalSetAt  DateTime?
  closedAt   DateTime?
  createdAt  DateTime        @default(now())
  owner      User            @relation("CohortOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    CohortMember[]
  sessions   CohortSession[]

  @@index([ownerId])
}

model CohortMember {
  cohortId String
  userId   String
  joinedAt DateTime @default(now())
  cohort   Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cohortId, userId])
  @@index([userId])
}

/// A pair room started from a cohort. The room is the session; this row only
/// says which cohort it belongs to, so the cohort page can show it while it
/// is live and the public lobby can leave it out.
model CohortSession {
  id        String   @id @default(cuid())
  cohortId  String
  roomId    String   @unique
  startedBy String
  startedAt DateTime @default(now())
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  room      PairRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([cohortId, startedAt])
}
