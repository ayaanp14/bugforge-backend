# Backend environment. Copy to `.env` and fill in — never commit the real file.
#
# Every secret in the platform lives here: the SPA has no server of its own, so
# anything that must not reach a browser is read by this process only.

# ── core ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@host:3306/codexa?connection_limit=5"
# Signs every session token. At least 32 random characters; generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out once. It must never appear in a file that is
# committed — a copy of it once did, in a backup env file, and had to be
# rotated.
JWT_SECRET=""
NODE_ENV=development
PORT=3001
FRONTEND_URL="http://localhost:3000"
# The public site, for the URLs in the content sitemaps the edge Worker
# fetches from /api/seo (routes/seo.ts). Defaults to https://codekairo.com.
# SITE_ORIGIN="https://codekairo.com"
BACKEND_PUBLIC_URL="http://localhost:3001"
REDIS_URL=""

# ── sign-up and password reset codes ────────────────────────────────────
# Where six-digit codes are posted, as JSON {email, otp, purpose} with
# purpose "verify_email" or "password_reset". Unset in development prints the
# code to this process's console instead (nothing is mailed); unset in
# production falls back to the flow URL that used to be hard-coded — set your
# own.
OTP_FLOW_URL=""
# A password account must confirm its address before it can sign in. "off"
# skips that — for the Playwright suite and a local database only, since a
# test runner cannot read a code off the console.
# EMAIL_VERIFICATION=off

# ── social sign-in (direct OAuth 2.0, no Firebase) ──────────────────────
# Register these callbacks with each provider:
#   $BACKEND_PUBLIC_URL/api/auth/github/callback
#   $BACKEND_PUBLIC_URL/api/auth/google/callback
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── code execution ──────────────────────────────────────────────────────
# Failover chain, tried left to right. Production uses the hosted engines.
# EXECUTOR=paiza,judge0
JUDGE0_URL="http://localhost:2358"

# ── written mock interview (NVIDIA Nemotron) ────────────────────────────
# Questions, marking and the closing report for the typed round.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
INTERVIEW_MODEL=nvidia/nemotron-3-super-120b-a12b
# The model that writes questions. It is the only one on the critical path:
# marking runs behind the response, but /answer blocks on this when the
# prefetch has not landed. Measured on the real prompt, 4 samples each:
#   super-120b   2.4s / 2.8s / 7.7s / 9.0s   (9-36 tok/s)
#   lightning-30b 2.1s / 2.3s / 3.1s / 3.2s  (31-43 tok/s)
# Same question quality, a far tighter tail. Unset falls back to INTERVIEW_MODEL.
INTERVIEW_QUESTION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# INTERVIEW_VOICE_MAX_OUTPUT_TOKENS=12000   # transcript scoring writes a lot

# ── site assistant (the chat dock) ──────────────────────────────────────
# Same provider and key as the interviews; streams over plain fetch. The
# handbook it answers from is content/handbook.md, the plans and the road are
# generated from code. Per-plan daily message caps are in src/lib/plans.ts.
# ASSISTANT_MODEL=                 # unset falls back to INTERVIEW_MODEL
# ASSISTANT_MAX_OUTPUT_TOKENS=700
# ASSISTANT_TIMEOUT_MS=60000

# ── resume ATS analyzer ─────────────────────────────────────────────────
# Same provider and key as the interviews. Without NVIDIA_API_KEY the
# analyzer still runs — the deterministic scoring, keyword matching and ATS
# checks — and reports that the model's review was unavailable; AI bullet
# rewrites and "optimise for this job" are refused with a 503.
# RESUME_MODEL=                    # unset falls back to INTERVIEW_MODEL
# RESUME_STRUCTURE_MAX_TOKENS=7000 # the model's restructuring of an uploaded resume
# RESUME_JUDGE_MAX_TOKENS=3500     # the review that feeds the two judgement categories
# RESUME_OPTIMIZE_MAX_TOKENS=3500
# RESUME_ANALYSIS_CONCURRENCY=2    # analyses run in-process, this many at a time

# ── live voice interview (Gemini Live) ──────────────────────────────────
# Used only to mint short-lived, single-use tokens for the browser's realtime
# socket. This key itself is never sent to the client.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_LIVE_VOICE=Charon
# REALTIME_PROVIDER=gemini

# ── subscriptions (Cashfree Payment Gateway) ────────────────────────────
# Sandbox keys from merchant.cashfree.com → Developers → API Keys.
# The secret also verifies webhook signatures, so it must match the account
# that the webhook URL is registered under.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# CASHFREE_FALLBACK_PHONE=9999999999

# ── reminders & jobs ────────────────────────────────────────────────────
# Where reminder mail is posted, as JSON {to, subject, text, html?, kind} —
# the same hosted-flow pattern as the OTP and registration webhooks. Unset
# skips the send; in-app notifications go out regardless.
EMAIL_WEBHOOK_URL=""
# JOBS_DISABLED=true            # stop the in-process scheduler (lib/scheduler.ts)

# ── misc ────────────────────────────────────────────────────────────────
# Opens /admin and /api/admin/* (comma-separated). This is the only admin
# list — nothing is built into the source; owner accounts (below) are admins too.
ADMIN_EMAIL=""
# Accounts that bypass every subscription check and quota (comma-separated).
# The creator's address, ayaanpathan14@gmail.com, is always included.
OWNER_EMAILS=""
REGISTRATION_FLOW_URL=""
